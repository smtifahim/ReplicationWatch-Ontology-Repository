    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasSciScoreMetadata ;
    skos:altLabel "SciScore_Version" ;
    cdbo:hasCompactURI "cdbo:hasSciScoreVersion" .

cdbo:hasSourceSheetColumnLabel a owl:AnnotationProperty ;
    rdfs:label "source sheet column label"@en ;
    dcterms:description "The name of the column or API field in an external source (for example a SciScore report) from which the value is taken."@en ;
    rdfs:subPropertyOf skos:hiddenLabel .

cdbo:hasSourceStudyID a owl:AnnotationProperty ;
    rdfs:label "Source Study ID" ;
    dcterms:description "Links a Claim record to the Study whose data produced it." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range CDBO:0000002 ;
    skos:altLabel "Source_Study_ID" ;
    cdbo:hasCompactURI "cdbo:hasSourceStudyID" .

cdbo:hasStatisticalTest a owl:AnnotationProperty ;
    rdfs:label "Statistical Test" ;
    obo:IAO_0000112 "Two-sample t-test" ;
    dcterms:description "The statistical test or model used for the group comparison or association." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasStatisticalMethodsMetadata ;
    skos:altLabel "Statistical_Test" ;
    cdbo:hasCompactURI "cdbo:hasStatisticalTest" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Statistical_Test",
  "description": "The statistical test or model used for the group comparison or association.",
  "example": "\\"Two-sample t-test\\"",
  "normalization": "Name the statistical test or model used for the group comparison or association, as the article names it. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasStudyDatasetRRID a owl:AnnotationProperty ;
    rdfs:label "Study Dataset RRID" ;
    dcterms:description "The RRID of the dataset, where the article or the SciScore report gives one. Derived, not extracted from free text by the LLM." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasStudyDataset ;
    skos:altLabel "Study_Dataset_RRID" ;
    cdbo:hasCompactURI "cdbo:hasStudyDatasetRRID" .

cdbo:hasStudyDesignType a owl:AnnotationProperty ;
    rdfs:label "Study Design Type" ;
    obo:IAO_0000112 "Cross-sectional case-control study using voxel-based morphometry." ;
    dcterms:description "The design of the study, for example case-control, longitudinal, cross-sectional or mega-analysis." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasStudyMetadata ;
    skos:altLabel "Study_Design_Type" ;
    cdbo:hasCompactURI "cdbo:hasStudyDesignType" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Study_Design_Type",
  "description": "The design of the study, for example case-control, longitudinal, cross-sectional or mega-analysis.",
  "example": "\\"Cross-sectional case-control study using voxel-based morphometry.\\"",
  "normalization": "Report the value as written in the article. If several values apply (for example several scanners or sites), list them separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'. Use the authors' own design term (for example case-control, longitudinal, cross-sectional, mega-analysis)."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Methods" .

cdbo:hasStudyID a owl:AnnotationProperty ;
    rdfs:label "Study ID" ;
    dcterms:description "A unique identifier for one Study, generated by the registry." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    skos:altLabel "Study_ID" ;
    cdbo:hasCompactURI "cdbo:hasStudyID" .

cdbo:hasStudyMetadataExtractionPrompt a owl:AnnotationProperty ;
    rdfs:label "Study Metadata Extraction Prompt"@en ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf cdbo:hasLLMExtractionPrompt ;
    skos:altLabel "Study_Metadata_Extraction_Prompt" .

cdbo:hasSynonym a owl:AnnotationProperty ;
    rdfs:label "Synonym"@en ;
    dcterms:description "A synonym of the term. Kept apart from skos:altLabel, which is reserved for the single ASCII-safe key."@en ;
    rdfs:subPropertyOf obo:IAO_0000118 .

cdbo:hasTypicalArticleSection a owl:AnnotationProperty ;
    rdfs:label "Typical Article Section"@en ;
    dcterms:description "The article section in which the value is typically found. Used to route extraction and to check quotes."@en ;
    rdfs:range cdbo:articleSectionType .

cdbo:hasUnmappableClaimCondition a owl:AnnotationProperty ;
    rdfs:label "Claim Condition Unmappable" ;
    dcterms:description "The condition string that no ontology term matched. Held for curator review and contribution to InterLex." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimCondition ;
    skos:altLabel "Claim_Condition_Unmappable" ;
    cdbo:hasCompactURI "cdbo:hasUnmappableClaimCondition" .

cdbo:hasUnmappableClaimMeasure a owl:AnnotationProperty ;
    rdfs:label "Claim Measure Unmappable" ;
    dcterms:description "The measure string that no PATO quality matched, for example fractional anisotropy or gyrification index. Held for curator review and contribution to InterLex." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimMeasure ;
    skos:altLabel "Claim_Measure_Unmappable" ;
    cdbo:hasCompactURI "cdbo:hasUnmappableClaimMeasure" .

cdbo:hasUnmappableClaimRegion a owl:AnnotationProperty ;
    rdfs:label "Claim Region Unmappable" ;
    dcterms:description "The region string that no ontology term matched. Held for curator review and contribution to InterLex." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimRegion ;
    skos:altLabel "Claim_Region_Unmappable" ;
    cdbo:hasCompactURI "cdbo:hasUnmappableClaimRegion" .

cdbo:hasUnmappableImagingModality a owl:AnnotationProperty ;
    rdfs:label "Imaging Modality Unmappable" ;
    dcterms:description "The imaging modality string that no NIDM term matched. Held for curator review and contribution to NIDM-Terms in InterLex." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasImagingModality ;
    skos:altLabel "Imaging_Modality_Unmappable" ;
    cdbo:hasCompactURI "cdbo:hasUnmappableImagingModality" .

obo:IAO_0000118 a owl:AnnotationProperty ;
    rdfs:label "alternative label"@en ;
    rdfs:subPropertyOf cdbo:iaoAnnotationProperty .

obo:UBERON_0001062 a owl:Class ;
    rdfs:label "Anatomical Entity"@en .

dcterms:identifier a owl:AnnotationProperty ;
    rdfs:subPropertyOf cdbo:dctermsMetadata .

CDBO:0000004 a owl:Class ;
    rdfs:label "Disease or Disorder"@en ;
    dcterms:description "A disease, disorder or phenotypic abnormality that is the condition of a claim. Grounded to MONDO, then HP."@en .

cdbo:ageGroupType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Child" "Adolescent" "Adult" "Older Adult" "Mixed" "Not Specified" ) ] .

cdbo:articleClassType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Primary" "Secondary" ) ] .

cdbo:claimRoleType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Main" "Supporting" ) ] .

cdbo:directionType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Increased" "Decreased" "No Difference" "Positive Association" "Negative Association" "No Association" ) ] .

cdbo:documentType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Native PDF" "Scanned PDF" ) ] .

cdbo:evidenceLevelType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Full Text" "Abstract Only" ) ] .

cdbo:hasClaimKey a owl:AnnotationProperty ;
    rdfs:label "Claim Key" ;
    dcterms:description "A deterministic key built from the grounded condition, region, laterality, measure and direction. Claim records with the same key are the same claim reported by different publications." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimRegistrationMetadata ;
    skos:altLabel "Claim_Key" ;
    cdbo:hasCompactURI "cdbo:hasClaimKey" .

cdbo:hasClaimLaterality a owl:AnnotationProperty ;
    rdfs:label "Claim Laterality" ;
    obo:IAO_0000112 "Right" ;
    dcterms:bibliographicCitation "Morgan RL, Whaley P, Thayer KA, Schünemann HJ. Identifying the PECO: A framework for formulating good questions to explore the association of environmental and other exposures with health outcomes. Environment International 2018;121(Pt 1):1027-1031. doi:10.1016/j.envint.2018.07.015",
        "Richardson WS, Wilson MC, Nishikawa J, Hayward RS. The well-built clinical question: a key to evidence-based decisions. ACP Journal Club 1995;123(3):A12-3." ;
    dcterms:description "The side of the brain to which the region refers." ;
    rdfs:comment "Outcome (PICO and PECO): part of the finding of the claim."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:lateralityType ;
    rdfs:subPropertyOf cdbo:hasClaimSlotMetadata ;
    skos:altLabel "Claim_Laterality" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Laterality",
  "description": "The side of the brain to which the region refers.",
  "example": "\\"Right\\"",
  "allowed_values": [
    "Left",
    "Right",
    "Bilateral",
    "Not Specified"
  ],
  "normalization": "Write Left or Right if the article gives the side for this region, and Bilateral only if the article says bilateral or both hemispheres. If no side is given, write 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimLaterality" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasDatasetMetadata a owl:AnnotationProperty ;
    rdfs:label "Dataset Metadata" ;
    dcterms:description "Grouping property for the dataset or cohort whose participants were studied." ;
    dcterms:type cdbo:grouping ;
    rdfs:domain CDBO:0000002 ;
    rdfs:subPropertyOf cdbo:hasStudyMetadata ;
    skos:altLabel "Dataset_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasDatasetMetadata" .

cdbo:hasPublicationDate a owl:AnnotationProperty ;
    rdfs:label "Publication Date" ;
    dcterms:description "The date the article was published." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf cdbo:hasBibliographicMetadata ;
    skos:altLabel "Publication_Date" ;
    cdbo:hasCompactURI "cdbo:hasPublicationDate" .

cdbo:hasStudyDataset a owl:AnnotationProperty ;
    rdfs:label "Study Dataset" ;
    obo:IAO_0000112 "Autism Brain Imaging Data Exchange (ABIDE)" ;
    dcterms:description "The dataset or cohort whose participants were studied, as named in the article. Used to flag claims that share a cohort and are therefore not independent." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasDatasetMetadata ;
    skos:altLabel "Study_Dataset" ;
    cdbo:hasCompactURI "cdbo:hasStudyDataset" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Study_Dataset",
  "description": "The dataset or cohort whose participants were studied, as named in the article. Used to flag claims that share a cohort and are therefore not independent.",
  "example": "\\"Autism Brain Imaging Data Exchange (ABIDE)\\"",
  "normalization": "Give the name of the dataset or cohort as the article names it (for example ABCD Study, ABIDE). If the authors recruited the participants themselves and name no dataset, write 'Local recruitment'. If several datasets were pooled, list them separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:lateralityType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Left" "Right" "Bilateral" "Not Specified" ) ] .

cdbo:morphometryMethodType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Voxel-Based Morphometry" "Surface-Based Morphometry" "Region-of-Interest Volumetry" "Manual Tracing" "Tensor-Based Morphometry" "Other" "Not Specified" ) ] .

cdbo:sexGroupType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Male Only" "Female Only" "Mixed" "Not Specified" ) ] .

cdbo:variableType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Diagnosis" "Trait or Phenotype" "Exposure" "Demographic" "Other" ) ] .

cdbo:articleSectionType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Abstract" "Conclusion" "Discussion" "Figures" "Introduction" "Methods" "References" "Results" "Tables" "Title" ) ] .

cdbo:hasAnalysisSoftware a owl:AnnotationProperty ;
    rdfs:label "Analysis Software" ;
    obo:IAO_0000112 "FreeSurfer" ;
    dcterms:description "The software used to analyze the images, as named in the article." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasAnalysisMetadata ;
    skos:altLabel "Analysis_Software" ;
    cdbo:hasCompactURI "cdbo:hasAnalysisSoftware" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Analysis_Software",
  "description": "The software used to analyze the images, as named in the article.",
  "example": "\\"FreeSurfer\\"",
  "normalization": "List each analysis tool as named in the article, without version numbers, separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasClaimMeasure a owl:AnnotationProperty ;
    rdfs:label "Claim Measure" ;
    obo:IAO_0000112 "gray matter volume" ;
    dcterms:bibliographicCitation "Morgan RL, Whaley P, Thayer KA, Schünemann HJ. Identifying the PECO: A framework for formulating good questions to explore the association of environmental and other exposures with health outcomes. Environment International 2018;121(Pt 1):1027-1031. doi:10.1016/j.envint.2018.07.015",
        "Richardson WS, Wilson MC, Nishikawa J, Hayward RS. The well-built clinical question: a key to evidence-based decisions. ACP Journal Club 1995;123(3):A12-3." ;
    dcterms:description "The imaging-derived measure the claim is about, exactly as written in the article." ;
    rdfs:comment "Outcome (PICO and PECO): part of the finding of the claim."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimSlotMetadata ;
    skos:altLabel "Claim_Measure" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Measure",
  "description": "The imaging-derived measure the claim is about, exactly as written in the article.",
  "example": "\\"gray matter volume\\"",
  "normalization": "Copy the words the article uses for the imaging-derived measure (for example gray matter volume, cortical thickness). One measure per claim."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimMeasure" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasClaimRegistrationMetadata a owl:AnnotationProperty ;
    rdfs:label "Claim Registration Metadata" ;
    dcterms:bibliographicCitation "Groth P, Gibson A, Velterop J. The anatomy of a nanopublication. Information Services and Use 2010;30:51-56. doi:10.3233/ISU-2010-0613" ;
    dcterms:description "Grouping property for values that scripts derive after extraction: the claim key and the ontology versions used for grounding." ;
    dcterms:type cdbo:grouping ;
    rdfs:comment "Derived values, including the ontology versions used for grounding, recorded as provenance of the assertion."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:subPropertyOf cdbo:hasClaimRecordMetadata ;
    skos:altLabel "Claim_Registration_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasClaimRegistrationMetadata" .

cdbo:hasImagingModality a owl:AnnotationProperty ;
    rdfs:label "Imaging Modality" ;
    obo:IAO_0000112 "T1-weighted structural MRI" ;
    dcterms:description "The imaging modality and contrast analyzed." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasImagingMetadata ;
    skos:altLabel "Imaging_Modality" ;
    cdbo:hasCompactURI "cdbo:hasImagingModality" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Imaging_Modality",
  "description": "The imaging modality and contrast analyzed.",
  "example": "\\"T1-weighted structural MRI\\"",
  "normalization": "Report the value as written in the article. If several values apply (for example several scanners or sites), list them separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasClaimCondition a owl:AnnotationProperty ;
    rdfs:label "Claim Condition" ;
    obo:IAO_0000112 "autism spectrum disorder" ;
    dcterms:bibliographicCitation "Morgan RL, Whaley P, Thayer KA, Schünemann HJ. Identifying the PECO: A framework for formulating good questions to explore the association of environmental and other exposures with health outcomes. Environment International 2018;121(Pt 1):1027-1031. doi:10.1016/j.envint.2018.07.015",
        "Richardson WS, Wilson MC, Nishikawa J, Hayward RS. The well-built clinical question: a key to evidence-based decisions. ACP Journal Club 1995;123(3):A12-3." ;
    dcterms:description "The condition or variable of interest of the claim, exactly as written in the article. It is not normalized by the LLM." ;
    rdfs:comment "Population (PICO) or exposure group (PECO): the target group of the claim."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimSlotMetadata ;
    skos:altLabel "Claim_Condition" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Condition",
  "description": "The condition or variable of interest of the claim, exactly as written in the article. It is not normalized by the LLM.",
  "example": "\\"autism spectrum disorder\\"",
  "normalization": "Copy the words the article uses for the group or variable of interest, without normalizing or expanding them (keep 'ASD' if the article writes 'ASD'). If the claim compares one group with another, give the target group here and the reference group in Claim_Comparator."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimCondition" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasClaimRegion a owl:AnnotationProperty ;
    rdfs:label "Claim Region" ;
    obo:IAO_0000112 "medial superior frontal gyrus" ;
    dcterms:bibliographicCitation "Morgan RL, Whaley P, Thayer KA, Schünemann HJ. Identifying the PECO: A framework for formulating good questions to explore the association of environmental and other exposures with health outcomes. Environment International 2018;121(Pt 1):1027-1031. doi:10.1016/j.envint.2018.07.015",
        "Richardson WS, Wilson MC, Nishikawa J, Hayward RS. The well-built clinical question: a key to evidence-based decisions. ACP Journal Club 1995;123(3):A12-3." ;
    dcterms:description "The brain region of the claim, exactly as written in the article, without the laterality." ;
    rdfs:comment "Outcome (PICO and PECO): part of the finding of the claim."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimSlotMetadata ;
    skos:altLabel "Claim_Region" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Region",
  "description": "The brain region of the claim, exactly as written in the article, without the laterality.",
  "example": "\\"medial superior frontal gyrus\\"",
  "normalization": "Copy the region name exactly as written, without the words left, right or bilateral, which belong in Claim_Laterality. Keep any other modifiers (for example 'medial superior frontal gyrus'). One region per claim."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimRegion" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasPublicationLink a owl:AnnotationProperty ;
    rdfs:label "Publication Link" ;
    dcterms:description "A link to the article." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf cdbo:hasBibliographicMetadata ;
    skos:altLabel "Publication_Link" ;
    cdbo:hasCompactURI "cdbo:hasPublicationLink" .

cdbo:hasStatisticalMethodsMetadata a owl:AnnotationProperty ;
    rdfs:label "Statistical Methods Metadata" ;
    dcterms:description "Grouping property for the statistical methods described in the Methods section." ;
    dcterms:type cdbo:grouping ;
    rdfs:domain CDBO:0000002 ;
    rdfs:subPropertyOf cdbo:hasStudyMetadata ;
    skos:altLabel "Statistical_Methods_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasStatisticalMethodsMetadata" .

cdbo:yesNoType a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:oneOf ( "Yes" "No" "Not Specified" ) ] .

cdbo:hasClaimRecordMetadata a owl:AnnotationProperty ;
    rdfs:label "Claim Record Metadata" ;
    dcterms:description "Grouping property for everything recorded about one Claim record. Fields are extracted from the article by the claims call, except the registration fields, which scripts derive afterwards." ;
    dcterms:type cdbo:grouping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:subPropertyOf cdbo:hasClaimsDBMetadata ;
    skos:altLabel "Claim_Record_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasClaimRecordMetadata" ;
    cdbo:hasGeneralClaimExtractionPrompt """{
  "role": "You are extracting every claim that one neuroimaging article makes about regional brain anatomy from its own results.",
  "task": "You are given the article text and a set of fields, each supplied separately as a compact fragment (field, description, example, allowed values and extraction rule). Return one JSON object with a single key 'claims', an array with one object per claim. Each object has one key per fragment, named by the fragment's 'field' value.",
  "output_schema": {
    "type": "object",
    "keys": [
      "claims"
    ],
    "claims": "array of objects, one per atomic claim"
  },
  "claim_rules": [
    "Extract only claims that this study reports from its own data. Do not extract findings the article attributes to earlier studies, hypotheses, predictions or recommendations.",
    "Extract every distinct main claim and every supporting claim about a brain region and an imaging-derived measure, including explicit findings of no difference or no association.",
    "One claim covers one condition, one region, one measure and one direction against one comparator. Split a sentence that reports several regions, measures, directions or population subgroups (for example children and adults, or males and females) into several claims, each with the age, sex and sample of its own subgroup.",
    "Every claim needs an evidence quote copied exactly from the supplied text. If no supporting passage exists, do not return the claim.",
    "Findings given only in a figure that the text does not state are not extracted.",
    "If the article reports no qualifying claim, return an empty array."
  ],
  "global_rules": [
    "Use only the supplied article text. Do not use outside knowledge to fill a value.",
    "If a value is not reported, write the literal string 'Not Specified', except where a field's own rule says otherwise.",
    "Repair obvious text-extraction artifacts in values (words split across lines or columns, stray hyphens, spaces inserted inside words), but never alter the characters of an evidence quote.",
    "Do not invent identifiers, links or numbers."
  ]
}"""^^rdf:JSON .

cdbo:iaoAnnotationProperty a owl:AnnotationProperty ;
    rdfs:label "iao:topAnnotationProperty"@en .

cdbo:hasAnalysisMetadata a owl:AnnotationProperty ;
    rdfs:label "Analysis Metadata" ;
    dcterms:description "Grouping property for image analysis details: software, atlas, settings and operating system." ;
    dcterms:type cdbo:grouping ;
    rdfs:domain CDBO:0000002 ;
    rdfs:subPropertyOf cdbo:hasStudyMetadata ;
    skos:altLabel "Analysis_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasAnalysisMetadata" .

cdbo:hasBibliographicMetadata a owl:AnnotationProperty ;
    rdfs:label "Bibliographic Metadata" ;
    dcterms:description "Grouping property for the bibliographic identity of a publication: title, authors, date, venue and links." ;
    dcterms:type cdbo:grouping ;
    rdfs:domain CDBO:0000001 ;
    rdfs:subPropertyOf cdbo:hasClaimsDBMetadata ;
    skos:altLabel "Bibliographic_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasBibliographicMetadata" .

cdbo:hasExtractionProvenanceMetadata a owl:AnnotationProperty ;
    rdfs:label "Extraction Provenance Metadata" ;
    dcterms:bibliographicCitation "Groth P, Gibson A, Velterop J. The anatomy of a nanopublication. Information Services and Use 2010;30:51-56. doi:10.3233/ISU-2010-0613" ;
    dcterms:description "Grouping property for the versions and dates needed to reproduce an extraction run." ;
    dcterms:type cdbo:grouping ;
    rdfs:comment "Provenance of the extraction run, as in the provenance graph of a nanopublication."@en ;
    rdfs:domain CDBO:0000001 ;
    rdfs:subPropertyOf cdbo:hasClaimsDBMetadata ;
    skos:altLabel "Extraction_Provenance_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasExtractionProvenanceMetadata" .

cdbo:hasImagingMetadata a owl:AnnotationProperty ;
    rdfs:label "Imaging Metadata" ;
    dcterms:description "Grouping property for image acquisition details." ;
    dcterms:type cdbo:grouping ;
    rdfs:domain CDBO:0000002 ;
    rdfs:subPropertyOf cdbo:hasStudyMetadata ;
    skos:altLabel "Imaging_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasImagingMetadata" .

cdbo:hasStudyMetadata a owl:AnnotationProperty ;
    rdfs:label "Study Metadata" ;
    dcterms:description "Grouping property for what is reported once per study and shared by all of its claims: design, dataset, imaging, analysis and statistical methods." ;
    dcterms:type cdbo:grouping ;
    rdfs:domain CDBO:0000002 ;
    rdfs:subPropertyOf cdbo:hasClaimsDBMetadata ;
    skos:altLabel "Study_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasStudyMetadata" ;
    cdbo:hasGeneralStudyMetadataExtractionPrompt """{
  "role": "You are extracting the study-level methods metadata of one neuroimaging article.",
  "task": "You are given the article text and a set of fields, each supplied separately as a compact fragment (field, description, example, allowed values and extraction rule). Return one JSON object whose keys are the field names given by each fragment's 'field' value.",
  "output_schema": {
    "type": "object",
    "keys": "the 'field' value of each fragment",
    "values": "the extracted string"
  },
  "rules": [
    "Take values from the Methods section first, then from other sections.",
    "Report what the authors report; do not infer a value that is not stated.",
    "If the article reports several studies or samples, describe the sample that produced the main results."
  ],
  "global_rules": [
    "Use only the supplied article text. Do not use outside knowledge to fill a value.",
    "If a value is not reported, write the literal string 'Not Specified', except where a field's own rule says otherwise.",
    "Repair obvious text-extraction artifacts in values (words split across lines or columns, stray hyphens, spaces inserted inside words), but never alter the characters of an evidence quote.",
    "Do not invent identifiers, links or numbers."
  ]
}"""^^rdf:JSON .

cdbo:hasClaimStatementMetadata a owl:AnnotationProperty ;
    rdfs:label "Claim Statement Metadata" ;
    dcterms:bibliographicCitation "Clark T, Ciccarese PN, Goble CA. Micropublications: a semantic model for claims, evidence, arguments and annotations in biomedical communications. Journal of Biomedical Semantics 2014;5:28. doi:10.1186/2041-1480-5-28",
        "Groth P, Gibson A, Velterop J. The anatomy of a nanopublication. Information Services and Use 2010;30:51-56. doi:10.3233/ISU-2010-0613" ;
    dcterms:description "Grouping property for what the paper says and where it says it: the atomic claim, its supporting quote and its location." ;
    dcterms:type cdbo:grouping ;
    rdfs:comment "The statement is the assertion of a nanopublication; the quote and its location are the evidence of a micropublication."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:subPropertyOf cdbo:hasClaimRecordMetadata ;
    skos:altLabel "Claim_Statement_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasClaimStatementMetadata" .

cdbo:hasClaimsDBMetadata a owl:AnnotationProperty ;
    rdfs:label "ClaimsDB Metadata" ;
    dcterms:description "Root grouping property for all ClaimsDB metadata: registry, bibliographic, study, claim record, SciScore and extraction provenance. General extraction instructions that apply to every extracted field are attached to this property." ;
    dcterms:type cdbo:grouping ;
    skos:altLabel "ClaimsDB_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasClaimsDBMetadata" ;
    cdbo:hasGeneralClaimsDBExtractionPrompt """{
  "role": "You are extracting structured metadata and claims from one full-text neuroimaging article into a predefined set of fields, guided by the ClaimsDB Ontology (CDBO).",
  "task": "The article text is loaded once and reused, with prompt caching, across two sequential extraction calls: (1) Study Metadata (see hasStudyMetadata's hasGeneralStudyMetadataExtractionPrompt) and (2) Claims (see hasClaimRecordMetadata's hasGeneralClaimExtractionPrompt). Registry, bibliographic, SciScore, mapping and provenance fields are filled by scripts and are never requested from you.",
  "article_classification": "Whether the article is primary or secondary is decided by the registry before extraction and is authoritative. Secondary articles (for example reviews and meta-analyses) are not sent to these calls in version 0.1.",
  "scope": "Only MRI-based anatomical observations in humans are in scope. Ignore animal studies, functional-only measures and purely behavioral findings.",
  "global_rules": [
    "Use only the supplied article text. Do not use outside knowledge to fill a value.",
    "If a value is not reported, write the literal string 'Not Specified', except where a field's own rule says otherwise.",
    "Repair obvious text-extraction artifacts in values (words split across lines or columns, stray hyphens, spaces inserted inside words), but never alter the characters of an evidence quote.",
    "Do not invent identifiers, links or numbers."
  ]
}"""^^rdf:JSON .

cdbo:hasRegistryMetadata a owl:AnnotationProperty ;
    rdfs:label "Registry Metadata" ;
    dcterms:description "Grouping property for facts about a publication that are known before extraction begins: file type, full-text availability, article classification and duplicate detection." ;
    dcterms:type cdbo:grouping ;
    rdfs:domain CDBO:0000001 ;
    rdfs:subPropertyOf cdbo:hasClaimsDBMetadata ;
    skos:altLabel "Registry_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasRegistryMetadata" .

cdbo:hasClaimSlotMetadata a owl:AnnotationProperty ;
    rdfs:label "Claim Slot Metadata" ;
    dcterms:bibliographicCitation "Morgan RL, Whaley P, Thayer KA, Schünemann HJ. Identifying the PECO: A framework for formulating good questions to explore the association of environmental and other exposures with health outcomes. Environment International 2018;121(Pt 1):1027-1031. doi:10.1016/j.envint.2018.07.015",
        "Richardson WS, Wilson MC, Nishikawa J, Hayward RS. The well-built clinical question: a key to evidence-based decisions. ACP Journal Club 1995;123(3):A12-3." ;
    dcterms:description "Grouping property for the claim parsed into slots: condition, comparator, region, laterality, measure and direction. Each slot that is grounded to an ontology carries mapped, CURIE and unmappable sibling properties." ;
    dcterms:type cdbo:grouping ;
    rdfs:comment "The slots map to the elements of PICO and PECO: condition and variable type are the population or the exposure group, the comparator is the comparison, and region, laterality, measure and direction are the outcome. PECO fits observational neuroimaging contrasts better than PICO."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:subPropertyOf cdbo:hasClaimRecordMetadata ;
    skos:altLabel "Claim_Slot_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasClaimSlotMetadata" .

cdbo:hasLLMExtractionPrompt a owl:AnnotationProperty ;
    rdfs:label "LLM Extraction Prompt"@en ;
    dcterms:description "Container for serialized JSON prompts and the grouping parent of the prompt properties."@en ;
    rdfs:range rdf:JSON ;
    skos:altLabel "LLM_Extraction_Prompt" .

cdbo:dctermsMetadata a owl:AnnotationProperty ;
    rdfs:label "dcterms:topMetadataProperty"@en .

cdbo:hasSciScoreMetadata a owl:AnnotationProperty ;
    rdfs:label "SciScore Metadata" ;
    dcterms:description "Grouping property for the reporting-quality profile of a publication returned by SciScore. Populated by an API call per unique article, not by the LLM." ;
    dcterms:type cdbo:grouping ;
    rdfs:domain CDBO:0000001 ;
    rdfs:subPropertyOf cdbo:hasClaimsDBMetadata ;
    skos:altLabel "SciScore_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasSciScoreMetadata" .

cdbo:hasClaimContextMetadata a owl:AnnotationProperty ;
    rdfs:label "Claim Context Metadata" ;
    dcterms:bibliographicCitation "Richardson WS, Wilson MC, Nishikawa J, Hayward RS. The well-built clinical question: a key to evidence-based decisions. ACP Journal Club 1995;123(3):A12-3." ;
    dcterms:description "Grouping property for the paper-specific context of a claim that is displayed to experts for comparison: the population the claim applies to and its statistics." ;
    dcterms:type cdbo:grouping ;
    rdfs:comment "Population details of the group or subgroup to which the claim applies, and the statistics reported for it."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:subPropertyOf cdbo:hasClaimRecordMetadata ;
    skos:altLabel "Claim_Context_Metadata" ;
    cdbo:hasCompactURI "cdbo:hasClaimContextMetadata" .

cdbo:preprocessing a owl:NamedIndividual ;
    rdfs:label "Preprocessing"@en ;
    dcterms:description "Marks a property whose value is known before extraction begins, from the registry (file inspection, identifiers, classification). It is never requested from the LLM."@en .

cdbo:grouping a owl:NamedIndividual ;
    rdfs:label "Grouping"@en ;
    dcterms:description "Marks a property that only organizes related sub-properties and holds no extractable value of its own."@en .

cdbo:mapping a owl:NamedIndividual ;
    rdfs:label "Mapping"@en ;
    dcterms:description "Marks a property whose value is derived by a script from an already-extracted value, for example an ontology term matched to an exact term, or the claim key. It is never requested from the LLM."@en .

cdbo:lookupOnly a owl:NamedIndividual ;
    rdfs:label "Lookup Only"@en ;
    dcterms:description "Marks a property populated by an external lookup, an API call or the pipeline itself after extraction, such as a bibliographic lookup, a SciScore report or an extraction-run record. It is never requested from the LLM."@en .

CDBO:0000002 a owl:Class ;
    rdfs:label "Study"@en ;
    dcterms:description "A research study reported in a publication, with its participants, imaging, analysis and statistical methods."@en .

CDBO:0000001 a owl:Class ;
    rdfs:label "Publication"@en ;
    dcterms:description "A published article or preprint that reports one or more studies."@en .

CDBO:0000003 a owl:Class ;
    rdfs:label "Claim"@en ;
    dcterms:bibliographicCitation "Clark T, Ciccarese PN, Goble CA. Micropublications: a semantic model for claims, evidence, arguments and annotations in biomedical communications. Journal of Biomedical Semantics 2014;5:28. doi:10.1186/2041-1480-5-28",
        "Groth P, Gibson A, Velterop J. The anatomy of a nanopublication. Information Services and Use 2010;30:51-56. doi:10.3233/ISU-2010-0613" ;
    dcterms:description "One atomic claim as reported by one publication, identified by a registry-generated ID. Records with the same claim key are the same claim reported by different publications."@en ;
    rdfs:comment "A Claim record corresponds to the assertion of a nanopublication and to the claim of a micropublication. Claims can be exported as nanopublications, with the evidence and extraction fields as provenance. The supports and challenges relations of micropublications correspond to the Concordant relation and to the Opposite and NullVsEffect relations computed between claim groups in CSDO."@en .

