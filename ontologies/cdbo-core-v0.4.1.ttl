    rdfs:subPropertyOf cdbo:hasLLMExtractionPrompt ;
    skos:altLabel "General_ClaimsDB_Extraction_Prompt" .

cdbo:hasGeneralStudyMetadataExtractionPrompt a owl:AnnotationProperty ;
