    rdfs:label "Scanner Manufacturer Model" ;
    obo:IAO_0000112 "3.0 T Siemens Magnetom Prisma" ;
    dcterms:description "The manufacturer and model of the MRI scanner." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasImagingMetadata ;
    skos:altLabel "Scanner_Manufacturer_Model" ;
    cdbo:hasCompactURI "cdbo:hasScannerManufacturerModel" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Scanner_Manufacturer_Model",
  "description": "The manufacturer and model of the MRI scanner.",
  "example": "\\"3.0 T Siemens Magnetom Prisma\\"",
  "normalization": "Report the value as written in the article. If several values apply (for example several scanners or sites), list them separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'. Give manufacturer and model together."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasSciScoreDetectedResources a owl:AnnotationProperty ;
