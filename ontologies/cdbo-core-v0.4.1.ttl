    rdfs:subPropertyOf cdbo:hasLLMExtractionPrompt ;
    skos:altLabel "General_Study_Metadata_Extraction_Prompt" .

cdbo:hasGroundingOntologyVersions a owl:AnnotationProperty ;
    rdfs:label "Grounding Ontology Versions" ;
    dcterms:description "The ontology versions used when the claim slots were grounded, so that grounding can be reproduced and re-run." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf cdbo:hasClaimRegistrationMetadata ;
    skos:altLabel "Grounding_Ontology_Versions" ;
    cdbo:hasCompactURI "cdbo:hasGroundingOntologyVersions" .

cdbo:hasImageResolution a owl:AnnotationProperty ;
    rdfs:label "Image Resolution" ;
    obo:IAO_0000112 "1 mm isotropic voxels" ;
    dcterms:description "The spatial resolution of the acquired images." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasImagingMetadata ;
    skos:altLabel "Image_Resolution" ;
    cdbo:hasCompactURI "cdbo:hasImageResolution" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Image_Resolution",
  "description": "The spatial resolution of the acquired images.",
  "example": "\\"1 mm isotropic voxels\\"",
  "normalization": "Report the value as written in the article. If several values apply (for example several scanners or sites), list them separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'. Give the voxel size with units."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasImagingModalityMappedCurie a owl:AnnotationProperty ;
    rdfs:label "Imaging Modality Mapped Curie" ;
    dcterms:description "The CURIEs of the NIDM terms matched to the imaging modality text (acquisition modality, image contrast type and image usage type), with the term set version. Found by the grounding script." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf cdbo:hasImagingModality ;
    skos:altLabel "Imaging_Modality_Mapped_Curie" ;
    cdbo:hasCompactURI "cdbo:hasImagingModalityMappedCurie" .

cdbo:hasLLMSystemPrompt a owl:AnnotationProperty ;
    rdfs:label "LLM System Prompt"@en ;
    rdfs:subPropertyOf cdbo:hasLLMExtractionPrompt ;
    skos:altLabel "LLM_System_Prompt" .

cdbo:hasLLMUserPrompt a owl:AnnotationProperty ;
    rdfs:label "LLM User Prompt"@en ;
    rdfs:subPropertyOf cdbo:hasLLMExtractionPrompt ;
    skos:altLabel "LLM_User_Prompt" .

cdbo:hasListedAuthors a owl:AnnotationProperty ;
    rdfs:label "Listed Authors" ;
    dcterms:description "The authors of the article as listed. Taken from a bibliographic lookup; extracted by the LLM only as a fallback." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasBibliographicMetadata ;
    skos:altLabel "Listed_Authors" ;
    cdbo:hasCompactURI "cdbo:hasListedAuthors" .

cdbo:hasMagneticFieldStrength a owl:AnnotationProperty ;
    rdfs:label "Magnetic Field Strength" ;
    obo:IAO_0000112 "3 T" ;
    dcterms:description "The magnetic field strength of the scanner." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasImagingMetadata ;
    skos:altLabel "Magnetic_Field_Strength" ;
    cdbo:hasCompactURI "cdbo:hasMagneticFieldStrength" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Magnetic_Field_Strength",
  "description": "The magnetic field strength of the scanner.",
  "example": "\\"3 T\\"",
  "normalization": "Report the value as written in the article. If several values apply (for example several scanners or sites), list them separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'. Give the value with its unit (for example 3 T)."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasMappedClaimCondition a owl:AnnotationProperty ;
    rdfs:label "Claim Condition Mapped" ;
    dcterms:description "The ontology term for the condition, found by the deterministic grounding script (MONDO, then HP)." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range CDBO:0000004 ;
    rdfs:subPropertyOf cdbo:hasClaimCondition ;
    skos:altLabel "Claim_Condition_Mapped" ;
    cdbo:hasCompactURI "cdbo:hasMappedClaimCondition" .

cdbo:hasMappedClaimConditionCurie a owl:AnnotationProperty ;
    rdfs:label "Claim Condition Mapped CURIE" ;
    dcterms:description "The CURIE of the matched condition term, with the ontology version." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf cdbo:hasClaimCondition ;
    skos:altLabel "Claim_Condition_Mapped_Curie" ;
    cdbo:hasCompactURI "cdbo:hasMappedClaimConditionCurie" .

cdbo:hasMappedClaimLateralityCurie a owl:AnnotationProperty ;
    rdfs:label "Claim Laterality Mapped Curie" ;
    dcterms:description "The CURIE of the term for the side, found by the deterministic grounding script: BSPO left side or right side, and PATO bilateral. Not Specified has no term." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf cdbo:hasClaimLaterality ;
    skos:altLabel "Claim_Laterality_Mapped_Curie" ;
    cdbo:hasCompactURI "cdbo:hasMappedClaimLateralityCurie" .

cdbo:hasMappedClaimMeasureCurie a owl:AnnotationProperty ;
    rdfs:label "Claim Measure Mapped CURIE" ;
    dcterms:description "The CURIEs of the terms matched to the measure text by the grounding script, as a JSON list with the ontology versions. The first is the PATO quality (for example volume, thickness, area). A tissue term from UBERON follows when the measure names one (for example gray matter), so gray matter volume and white matter volume stay different measures." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf cdbo:hasClaimMeasure ;
    skos:altLabel "Claim_Measure_Mapped_Curie" ;
    cdbo:hasCompactURI "cdbo:hasMappedClaimMeasureCurie" .

cdbo:hasMappedClaimRegion a owl:AnnotationProperty ;
    rdfs:label "Claim Region Mapped" ;
    dcterms:description "The ontology term for the region, found by the deterministic grounding script (UBERON)." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range obo:UBERON_0001062 ;
    rdfs:subPropertyOf cdbo:hasClaimRegion ;
    skos:altLabel "Claim_Region_Mapped" ;
    cdbo:hasCompactURI "cdbo:hasMappedClaimRegion" .

cdbo:hasMappedClaimRegionCurie a owl:AnnotationProperty ;
    rdfs:label "Claim Region Mapped CURIE" ;
    dcterms:description "The CURIE of the matched region term, with the ontology version." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf cdbo:hasClaimRegion ;
    skos:altLabel "Claim_Region_Mapped_Curie" ;
    cdbo:hasCompactURI "cdbo:hasMappedClaimRegionCurie" .

cdbo:hasMorphometryMethod a owl:AnnotationProperty ;
    rdfs:label "Morphometry Method" ;
    obo:IAO_0000112 "Voxel-Based Morphometry" ;
    dcterms:description "The analysis technique used to measure brain structure, as a coarse category for filtering. The software, version and settings are recorded in their own fields. Candidate values for the NIDM-Terms vocabulary in InterLex." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range cdbo:morphometryMethodType ;
    rdfs:subPropertyOf cdbo:hasAnalysisMetadata ;
    skos:altLabel "Morphometry_Method" ;
    cdbo:hasCompactURI "cdbo:hasMorphometryMethod" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Morphometry_Method",
  "description": "The analysis technique used to measure brain structure, as a coarse category for filtering. The software, version and settings are recorded in their own fields. Candidate values for the NIDM-Terms vocabulary in InterLex.",
  "example": "\\"Voxel-Based Morphometry\\"",
  "allowed_values": [
    "Voxel-Based Morphometry",
    "Surface-Based Morphometry",
    "Region-of-Interest Volumetry",
    "Manual Tracing",
    "Tensor-Based Morphometry",
    "Other",
    "Not Specified"
  ],
  "normalization": "Choose the category that matches how the article measured brain structure: Voxel-Based Morphometry (voxel-wise comparison of tissue maps), Surface-Based Morphometry (cortical thickness, surface area or gyrification on a reconstructed surface), Region-of-Interest Volumetry (volumes of predefined regions from automated segmentation), Manual Tracing (regions outlined by hand), Tensor-Based Morphometry (deformation fields). Use Other for any other method and Not Specified if the article does not say. If several methods are used, give the one that produced the claim's finding."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasMultipleComparisonCorrection a owl:AnnotationProperty ;
    rdfs:label "Multiple Comparison Correction" ;
    obo:IAO_0000112 "False discovery rate correction at q < 0.05" ;
    dcterms:description "The method used to correct for multiple comparisons, with its threshold." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasStatisticalMethodsMetadata ;
    skos:altLabel "Multiple_Comparison_Correction" ;
    cdbo:hasCompactURI "cdbo:hasMultipleComparisonCorrection" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Multiple_Comparison_Correction",
  "description": "The method used to correct for multiple comparisons, with its threshold.",
  "example": "\\"False discovery rate correction at q < 0.05\\"",
  "normalization": "Name the correction method and its threshold as reported (for example FDR q < 0.05). If the article states that no correction was applied, write 'None'. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasOntologyVersion a owl:AnnotationProperty ;
    rdfs:label "Ontology Version" ;
    dcterms:description "The version of this ontology used for the extraction." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasExtractionProvenanceMetadata ;
    skos:altLabel "Ontology_Version" ;
    cdbo:hasCompactURI "cdbo:hasOntologyVersion" .

cdbo:hasOperatingSystem a owl:AnnotationProperty ;
    rdfs:label "Operating System" ;
    obo:IAO_0000112 "Ubuntu 20.04" ;
    dcterms:description "The operating system on which the analysis ran." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasAnalysisMetadata ;
    skos:altLabel "Operating_System" ;
    cdbo:hasCompactURI "cdbo:hasOperatingSystem" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Operating_System",
  "description": "The operating system on which the analysis ran.",
  "example": "\\"Ubuntu 20.04\\"",
  "normalization": "Report the value as written in the article. If several values apply (for example several scanners or sites), list them separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasPMCLink a owl:AnnotationProperty ;
    rdfs:label "PubMed Central Link" ;
    dcterms:description "The PubMed Central link of the article, where one exists." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf cdbo:hasPublicationLink ;
    skos:altLabel "PMC_Link" ;
    cdbo:hasCompactURI "cdbo:hasPMCLink" .

cdbo:hasParserVersion a owl:AnnotationProperty ;
