    rdfs:subPropertyOf cdbo:hasSciScoreMetadata ;
    skos:altLabel "SciScore_Rigor_Criteria" ;
    cdbo:hasCompactURI "cdbo:hasSciScoreRigorCriteria" .

cdbo:hasSciScoreRigorSubscore a owl:AnnotationProperty ;
