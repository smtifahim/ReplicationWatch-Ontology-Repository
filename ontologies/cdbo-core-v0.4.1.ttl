cdbo:hasPulseSequence a owl:AnnotationProperty ;
    rdfs:label "Pulse Sequence" ;
    obo:IAO_0000112 "MPRAGE, TR 2300 ms, TE 2.98 ms, flip angle 9 degrees" ;
