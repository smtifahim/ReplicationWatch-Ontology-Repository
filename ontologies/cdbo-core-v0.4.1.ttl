@prefix CDBO: <https://w3id.org/replicationwatch/cdbo/CDBO_> .
@prefix cdbo: <https://w3id.org/replicationwatch/cdbo/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

obo:IAO_0000112 a owl:AnnotationProperty ;
    rdfs:label "example of usage"@en ;
    rdfs:subPropertyOf cdbo:iaoAnnotationProperty .

obo:IAO_0000116 a owl:AnnotationProperty ;
    rdfs:label "editor note"@en ;
    rdfs:subPropertyOf cdbo:iaoAnnotationProperty .

obo:IAO_0000119 a owl:AnnotationProperty ;
    rdfs:label "definition source"@en ;
    rdfs:subPropertyOf cdbo:iaoAnnotationProperty .

dc:creator a owl:AnnotationProperty ;
    rdfs:subPropertyOf cdbo:dctermsMetadata .

dc:date a owl:AnnotationProperty ;
    rdfs:subPropertyOf cdbo:dctermsMetadata .

dc:description a owl:AnnotationProperty ;
    rdfs:subPropertyOf cdbo:dctermsMetadata .

dc:title a owl:AnnotationProperty ;
    rdfs:subPropertyOf cdbo:dctermsMetadata .

dcterms:bibliographicCitation a owl:AnnotationProperty ;
    rdfs:subPropertyOf cdbo:dctermsMetadata .

dcterms:description a owl:AnnotationProperty ;
    rdfs:subPropertyOf cdbo:dctermsMetadata .

dcterms:license a owl:AnnotationProperty ;
    rdfs:subPropertyOf cdbo:dctermsMetadata .

dcterms:type a owl:AnnotationProperty ;
    rdfs:subPropertyOf cdbo:dctermsMetadata .

cdbo:claimsdb-core.owl a owl:Ontology ;
    dc:creator "Fahim Imam - https://orcid.org/0000-0003-4752-543X" ;
    dc:date "November 5, 2026" ;
    dc:description "This ontology defines the metadata schema and LLM extraction instructions for ClaimsDB, a structured, queryable repository of claims extracted from MRI-based anatomical neuroimaging publications, as used by ReplicationWatch."@en ;
    dc:title "ClaimsDB Ontology (CDBO) Core" ;
    rdfs:comment """DRAFT v0.4.1. Contents:
- Five classes: Publication, Study, Claim (one claim record as reported by one publication), Disease or Disorder, and Anatomical Entity (UBERON).
- Property groups: Registry, Bibliographic, Study, Claim Record, SciScore and Extraction Provenance metadata. Every extractable field is an annotation property whose skos:altLabel is its ASCII-safe key in the data dictionary, database schema and JSON output.
- Field roles (dcterms:type): grouping, preprocessing, mapping, lookupOnly. Fields with no role are extracted by the LLM.
- Restricted datatypes for categorical fields.
- Per-field and general LLM extraction prompts (rdf:JSON), generated from the field descriptions, examples and extraction rules.
- Grounding resources, all applied by scripts after extraction: UBERON (regions and tissues), MONDO and HP (conditions), PATO (measure qualities and bilateral), BSPO (left and right side), the NIDM-Experiment terms (imaging modality, contrast, usage) and RRIDs (software, datasets). Terms with no match, such as 'medial superior frontal gyrus' or a morphometry method, are held for curators to contribute to InterLex.
- Standards: PICO and PECO, nanopublications, micropublications and AIDA are cited with dcterms:bibliographicCitation where they shaped a property.
- The namespace IRI is a placeholder and no license is set yet. Examples are illustrative."""@en ;
    owl:versionInfo "0.4.1-draft"@en .

cdbo:hasAnalysisSettings a owl:AnnotationProperty ;
    rdfs:label "Analysis Settings" ;
    obo:IAO_0000112 "Smoothing kernel of 8 mm FWHM; default recon-all settings." ;
    dcterms:description "Analysis settings that affect results, such as smoothing kernel, thresholds and preprocessing choices." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasAnalysisMetadata ;
    skos:altLabel "Analysis_Settings" ;
    cdbo:hasCompactURI "cdbo:hasAnalysisSettings" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Analysis_Settings",
  "description": "Analysis settings that affect results, such as smoothing kernel, thresholds and preprocessing choices.",
  "example": "\\"Smoothing kernel of 8 mm FWHM; default recon-all settings.\\"",
  "normalization": "Summarize only the settings that the article reports and that could change results (for example smoothing kernel, thresholds, preprocessing choices) in one short passage. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasAnalysisSoftwareRRID a owl:AnnotationProperty ;
    rdfs:label "Analysis Software RRID" ;
    dcterms:description "The RRID of the analysis software, taken from the article or the SciScore report. Derived, not extracted from free text by the LLM." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasAnalysisSoftware ;
    skos:altLabel "Analysis_Software_RRID" ;
    cdbo:hasCompactURI "cdbo:hasAnalysisSoftwareRRID" .

cdbo:hasAnalysisSoftwareVersion a owl:AnnotationProperty ;
    rdfs:label "Analysis Software Version" ;
    obo:IAO_0000112 "7.1.1" ;
    dcterms:description "The version of the analysis software." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasAnalysisSoftware ;
    skos:altLabel "Analysis_Software_Version" ;
    cdbo:hasCompactURI "cdbo:hasAnalysisSoftwareVersion" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Analysis_Software_Version",
  "description": "The version of the analysis software.",
  "example": "\\"7.1.1\\"",
  "normalization": "Give the version of each tool listed in Analysis_Software, in the same order, separated by semicolons. Use 'Not Specified' for any tool whose version is not reported."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasArticleClassification a owl:AnnotationProperty ;
    rdfs:label "Article Classification" ;
    dcterms:description "Whether the article reports its own primary study (Primary) or synthesizes other studies, such as a review or meta-analysis (Secondary). In version 0.1 secondary articles skip study and claim extraction." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range cdbo:articleClassType ;
    rdfs:subPropertyOf cdbo:hasRegistryMetadata ;
    skos:altLabel "Article_Classification" ;
    cdbo:hasCompactURI "cdbo:hasArticleClassification" .

cdbo:hasArticleTitle a owl:AnnotationProperty ;
    rdfs:label "Article Title" ;
    dcterms:description "The title of the article. Taken from a bibliographic lookup; extracted by the LLM only as a fallback." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasBibliographicMetadata ;
    skos:altLabel "Article_Title" ;
    cdbo:hasCompactURI "cdbo:hasArticleTitle" .

cdbo:hasAtlasParcellation a owl:AnnotationProperty ;
    rdfs:label "Atlas Parcellation" ;
    obo:IAO_0000112 "Desikan-Killiany atlas" ;
    dcterms:description "The atlas or parcellation used to define brain regions." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasAnalysisMetadata ;
    skos:altLabel "Atlas_Parcellation" ;
    cdbo:hasCompactURI "cdbo:hasAtlasParcellation" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Atlas_Parcellation",
  "description": "The atlas or parcellation used to define brain regions.",
  "example": "\\"Desikan-Killiany atlas\\"",
  "normalization": "Report the value as written in the article. If several values apply (for example several scanners or sites), list them separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'. Name the atlas or parcellation used to define the regions."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasAvailableSections a owl:AnnotationProperty ;
    rdfs:label "Available Sections" ;
    dcterms:description "The article sections detected in the source file, for example Abstract, Methods, Results and Tables." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasRegistryMetadata ;
    skos:altLabel "Available_Sections" ;
    cdbo:hasCompactURI "cdbo:hasAvailableSections" .

cdbo:hasClaimAgeGroup a owl:AnnotationProperty ;
    rdfs:label "Claim Age Group" ;
    obo:IAO_0000112 "Child" ;
    dcterms:description "The age group of the participants to which the claim applies. It is a coarse facet used to show whether claims about the same finding come from comparable ages." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:ageGroupType ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_Age_Group" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Age_Group",
  "description": "The age group of the participants to which the claim applies. It is a coarse facet used to show whether claims about the same finding come from comparable ages.",
  "example": "\\"Child\\"",
  "allowed_values": [
    "Child",
    "Adolescent",
    "Adult",
    "Older Adult",
    "Mixed",
    "Not Specified"
  ],
  "normalization": "Assign the age group of the participants this claim applies to. If the article names the group (for example children, adolescents, adults, older adults), use the matching value. Otherwise assign it from the reported age with these cut-offs: Child under 12 years, Adolescent 12 to 17 years, Adult 18 to 64 years, Older Adult 65 years or older. Use Mixed when the claim applies to a group that spans more than one of these groups, for example a whole-lifespan sample. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimAgeGroup" ;
    cdbo:hasTypicalArticleSection "Methods",
        "Results" .

cdbo:hasClaimAgeRange a owl:AnnotationProperty ;
    rdfs:label "Claim Age Range" ;
    obo:IAO_0000112 "mean 7.2 years (SD 1.1)" ;
    dcterms:description "The age of the participants to which the claim applies." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_Age_Range" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Age_Range",
  "description": "The age of the participants to which the claim applies.",
  "example": "\\"mean 7.2 years (SD 1.1)\\"",
  "normalization": "Give the age of the participants this claim applies to, as the article reports it for the group or subgroup (range, or mean with standard deviation). If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimAgeRange" ;
    cdbo:hasTypicalArticleSection "Methods",
        "Results" .

cdbo:hasClaimComparator a owl:AnnotationProperty ;
    rdfs:label "Claim Comparator" ;
    obo:IAO_0000112 "typically developing children" ;
    dcterms:bibliographicCitation "Morgan RL, Whaley P, Thayer KA, Schünemann HJ. Identifying the PECO: A framework for formulating good questions to explore the association of environmental and other exposures with health outcomes. Environment International 2018;121(Pt 1):1027-1031. doi:10.1016/j.envint.2018.07.015",
        "Richardson WS, Wilson MC, Nishikawa J, Hayward RS. The well-built clinical question: a key to evidence-based decisions. ACP Journal Club 1995;123(3):A12-3." ;
    dcterms:description "The reference group the finding is measured against, as written in the article. It is not part of the claim key and is displayed to experts. Not Applicable for association claims." ;
    rdfs:comment "Comparison (PICO and PECO): the comparison group of the claim."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimSlotMetadata ;
    skos:altLabel "Claim_Comparator" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Comparator",
  "description": "The reference group the finding is measured against, as written in the article. It is not part of the claim key and is displayed to experts. Not Applicable for association claims.",
  "example": "\\"typically developing children\\"",
  "normalization": "Copy the words the article uses for the reference group the finding is measured against (for example typically developing controls). For an association with a continuous variable, write 'Not Applicable'. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimComparator" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasClaimDiagnosticCriteria a owl:AnnotationProperty ;
    rdfs:label "Claim Diagnostic Criteria" ;
    obo:IAO_0000112 "DSM-5, confirmed with ADOS-2" ;
    dcterms:description "The criteria or instruments used to establish the diagnosis." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_Diagnostic_Criteria" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Diagnostic_Criteria",
  "description": "The criteria or instruments used to establish the diagnosis.",
  "example": "\\"DSM-5, confirmed with ADOS-2\\"",
  "normalization": "Give the criteria or instruments the article used to establish the diagnosis (for example DSM-5, ADOS-2). If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimDiagnosticCriteria" ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasClaimDirection a owl:AnnotationProperty ;
    rdfs:label "Claim Direction" ;
    obo:IAO_0000112 "Increased" ;
    dcterms:bibliographicCitation "Morgan RL, Whaley P, Thayer KA, Schünemann HJ. Identifying the PECO: A framework for formulating good questions to explore the association of environmental and other exposures with health outcomes. Environment International 2018;121(Pt 1):1027-1031. doi:10.1016/j.envint.2018.07.015",
        "Richardson WS, Wilson MC, Nishikawa J, Hayward RS. The well-built clinical question: a key to evidence-based decisions. ACP Journal Club 1995;123(3):A12-3." ;
    dcterms:description "The direction of the finding relative to the comparator, or of the association." ;
    rdfs:comment "Outcome (PICO and PECO): part of the finding of the claim."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:directionType ;
    rdfs:subPropertyOf cdbo:hasClaimSlotMetadata ;
    skos:altLabel "Claim_Direction" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Direction",
  "description": "The direction of the finding relative to the comparator, or of the association.",
  "example": "\\"Increased\\"",
  "allowed_values": [
    "Increased",
    "Decreased",
    "No Difference",
    "Positive Association",
    "Negative Association",
    "No Association"
  ],
  "normalization": "Give the direction of the finding for the target group relative to the comparator: Increased or Decreased for a group difference; Positive Association or Negative Association for a relationship with a continuous variable. Write No Difference or No Association only when the article explicitly reports no significant difference or association. A non-significant trend is No Difference."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimDirection" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasClaimEffectSize a owl:AnnotationProperty ;
    rdfs:label "Claim Effect Size" ;
    obo:IAO_0000112 "Cohen's d = 0.35" ;
    dcterms:description "The effect size reported for the claim." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_Effect_Size" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Effect_Size",
  "description": "The effect size reported for the claim.",
  "example": "\\"Cohen's d = 0.35\\"",
  "normalization": "Give the effect size for this claim with the name of the statistic, as reported. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimEffectSize" ;
    cdbo:hasTypicalArticleSection "Results",
        "Tables" .

cdbo:hasClaimEvidenceLevel a owl:AnnotationProperty ;
    rdfs:label "Claim Evidence Level" ;
    dcterms:bibliographicCitation "Clark T, Ciccarese PN, Goble CA. Micropublications: a semantic model for claims, evidence, arguments and annotations in biomedical communications. Journal of Biomedical Semantics 2014;5:28. doi:10.1186/2041-1480-5-28",
        "Groth P, Gibson A, Velterop J. The anatomy of a nanopublication. Information Services and Use 2010;30:51-56. doi:10.3233/ISU-2010-0613" ;
    dcterms:description "Whether the claim was extracted from the full text or from the abstract only. Set by the registry." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:comment "Evidence supporting the claim (micropublication) and provenance of the assertion (nanopublication)."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:evidenceLevelType ;
    rdfs:subPropertyOf cdbo:hasClaimStatementMetadata ;
    skos:altLabel "Claim_Evidence_Level" ;
    cdbo:hasCompactURI "cdbo:hasClaimEvidenceLevel" .

cdbo:hasClaimEvidenceQuote a owl:AnnotationProperty ;
    rdfs:label "Claim Evidence Quote" ;
    obo:IAO_0000112 "Results demonstrated young children with ASD had increased gray matter volumes (GMVs) in the right medial superior frontal gyrus and left fusiform gyrus compared with the TD group." ;
    dcterms:bibliographicCitation "Clark T, Ciccarese PN, Goble CA. Micropublications: a semantic model for claims, evidence, arguments and annotations in biomedical communications. Journal of Biomedical Semantics 2014;5:28. doi:10.1186/2041-1480-5-28",
        "Groth P, Gibson A, Velterop J. The anatomy of a nanopublication. Information Services and Use 2010;30:51-56. doi:10.3233/ISU-2010-0613" ;
    dcterms:description "The verbatim passage of the article that supports the claim. The pipeline rejects a claim whose quote cannot be found in the source text." ;
    rdfs:comment "Evidence supporting the claim (micropublication) and provenance of the assertion (nanopublication)."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimStatementMetadata ;
    skos:altLabel "Claim_Evidence_Quote" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Evidence_Quote",
  "description": "The verbatim passage of the article that supports the claim. The pipeline rejects a claim whose quote cannot be found in the source text.",
  "example": "\\"Results demonstrated young children with ASD had increased gray matter volumes (GMVs) in the right medial superior frontal gyrus and left fusiform gyrus compared with the TD group.\\"",
  "normalization": "Copy the shortest passage from the supplied text that supports the claim, exactly as it appears, character for character, including hyphens, symbols and spacing. Do not paraphrase, shorten with ellipses or join separate passages. If one sentence supports several claims, repeat the same quote for each. For a table, copy the serialized row text as supplied, including its row and column labels."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimEvidenceQuote" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasClaimExtractionPrompt a owl:AnnotationProperty ;
    rdfs:label "Claim Extraction Prompt"@en ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf cdbo:hasLLMExtractionPrompt ;
    skos:altLabel "Claim_Extraction_Prompt" .

cdbo:hasClaimID a owl:AnnotationProperty ;
    rdfs:label "Claim ID" ;
    dcterms:description "A unique identifier for one Claim record, meaning one atomic claim as reported by one publication. Generated by the registry at claim registration." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    skos:altLabel "Claim_ID" ;
    cdbo:hasCompactURI "cdbo:hasClaimID" .

cdbo:hasClaimKeyComplete a owl:AnnotationProperty ;
    rdfs:label "Claim Key Complete" ;
    dcterms:description "Whether every slot of the claim key was grounded. An incomplete key is never merged with another." ;
    dcterms:type cdbo:mapping ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:yesNoType ;
    rdfs:subPropertyOf cdbo:hasClaimKey ;
    skos:altLabel "Claim_Key_Complete" ;
    cdbo:hasCompactURI "cdbo:hasClaimKeyComplete" .

cdbo:hasClaimPValue a owl:AnnotationProperty ;
    rdfs:label "Claim P-Value" ;
    obo:IAO_0000112 "p = 0.002" ;
    dcterms:description "The p-value reported for the claim." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_P_Value" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_P_Value",
  "description": "The p-value reported for the claim.",
  "example": "\\"p = 0.002\\"",
  "normalization": "Give the p-value for this claim as reported, with its correction note if stated (for example 'p = 0.002, FWE-corrected'). If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimPValue" ;
    cdbo:hasTypicalArticleSection "Results",
        "Tables" .

cdbo:hasClaimPopulationQualifiers a owl:AnnotationProperty ;
    rdfs:label "Claim Population Qualifiers" ;
    obo:IAO_0000112 "comorbid ADHD excluded; unmedicated" ;
    dcterms:description "Other qualifiers of the population, such as comorbidity or medication status." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_Population_Qualifiers" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Population_Qualifiers",
  "description": "Other qualifiers of the population, such as comorbidity or medication status.",
  "example": "\\"comorbid ADHD excluded; unmedicated\\"",
  "normalization": "Give other population qualifiers the article reports for this claim, such as comorbidity, medication status or exclusions, separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimPopulationQualifiers" ;
    cdbo:hasTypicalArticleSection "Methods",
        "Results" .

cdbo:hasClaimRole a owl:AnnotationProperty ;
    rdfs:label "Claim Role" ;
    obo:IAO_0000112 "Main" ;
    dcterms:description "Whether the claim is a main claim of the article or a supporting one." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:claimRoleType ;
    rdfs:subPropertyOf cdbo:hasClaimStatementMetadata ;
    skos:altLabel "Claim_Role" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Role",
  "description": "Whether the claim is a main claim of the article or a supporting one.",
  "example": "\\"Main\\"",
  "allowed_values": [
    "Main",
    "Supporting"
  ],
  "normalization": "Write Main if the article states the claim as a principal finding in its abstract or conclusions. Write Supporting for any other finding of this study that the article reports."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimRole" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasClaimSampleSize a owl:AnnotationProperty ;
    rdfs:label "Claim Sample Size" ;
    obo:IAO_0000112 "48 participants with ASD and 63 typically developing controls" ;
    dcterms:description "The number of participants in each group the claim compares." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_Sample_Size" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Sample_Size",
  "description": "The number of participants in each group the claim compares.",
  "example": "\\"48 participants with ASD and 63 typically developing controls\\"",
  "normalization": "Give the number of participants in each group that this claim compares. If the claim applies to a subgroup, give the subgroup sizes. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimSampleSize" ;
    cdbo:hasTypicalArticleSection "Methods",
        "Results" .

cdbo:hasClaimSexDistribution a owl:AnnotationProperty ;
    rdfs:label "Claim Sex Distribution" ;
    obo:IAO_0000112 "39 male and 9 female in the ASD group" ;
    dcterms:description "The sex distribution of the participants to which the claim applies." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_Sex_Distribution" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Sex_Distribution",
  "description": "The sex distribution of the participants to which the claim applies.",
  "example": "\\"39 male and 9 female in the ASD group\\"",
  "normalization": "Give the sex distribution of the participants this claim applies to, as reported for the group or subgroup. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimSexDistribution" ;
    cdbo:hasTypicalArticleSection "Methods",
        "Results" .

cdbo:hasClaimSexGroup a owl:AnnotationProperty ;
    rdfs:label "Claim Sex Group" ;
    obo:IAO_0000112 "Mixed" ;
    dcterms:description "The sex composition of the participants to which the claim applies. It is a coarse facet used to show whether claims about the same finding come from comparable samples." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:sexGroupType ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_Sex_Group" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Sex_Group",
  "description": "The sex composition of the participants to which the claim applies. It is a coarse facet used to show whether claims about the same finding come from comparable samples.",
  "example": "\\"Mixed\\"",
  "allowed_values": [
    "Male Only",
    "Female Only",
    "Mixed",
    "Not Specified"
  ],
  "normalization": "Assign the sex composition of the participants this claim applies to: Male Only, Female Only, or Mixed when both sexes are included in the group or subgroup the claim is about. Use the sex distribution you reported for this claim. If the article does not report the sex of the participants, write 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimSexGroup" ;
    cdbo:hasTypicalArticleSection "Methods",
        "Results" .

cdbo:hasClaimSourceReference a owl:AnnotationProperty ;
    rdfs:label "Claim Source Reference" ;
    obo:IAO_0000112 "Table 2" ;
    dcterms:bibliographicCitation "Clark T, Ciccarese PN, Goble CA. Micropublications: a semantic model for claims, evidence, arguments and annotations in biomedical communications. Journal of Biomedical Semantics 2014;5:28. doi:10.1186/2041-1480-5-28",
        "Groth P, Gibson A, Velterop J. The anatomy of a nanopublication. Information Services and Use 2010;30:51-56. doi:10.3233/ISU-2010-0613" ;
    dcterms:description "The table or figure the claim draws on, if any." ;
    rdfs:comment "Evidence supporting the claim (micropublication) and provenance of the assertion (nanopublication)."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimStatementMetadata ;
    skos:altLabel "Claim_Source_Reference" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Source_Reference",
  "description": "The table or figure the claim draws on, if any.",
  "example": "\\"Table 2\\"",
  "normalization": "Give the table or figure that the claim draws on, with its label as printed (for example Table 2). If the claim rests on running text only, write an empty string."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimSourceReference" ;
    cdbo:hasTypicalArticleSection "Figures",
        "Results",
        "Tables" .

cdbo:hasClaimSourceSection a owl:AnnotationProperty ;
    rdfs:label "Claim Source Section" ;
    obo:IAO_0000112 "Results" ;
    dcterms:bibliographicCitation "Clark T, Ciccarese PN, Goble CA. Micropublications: a semantic model for claims, evidence, arguments and annotations in biomedical communications. Journal of Biomedical Semantics 2014;5:28. doi:10.1186/2041-1480-5-28",
        "Groth P, Gibson A, Velterop J. The anatomy of a nanopublication. Information Services and Use 2010;30:51-56. doi:10.3233/ISU-2010-0613" ;
    dcterms:description "The article section from which the quote was taken." ;
    rdfs:comment "Evidence supporting the claim (micropublication) and provenance of the assertion (nanopublication)."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:articleSectionType ;
    rdfs:subPropertyOf cdbo:hasClaimStatementMetadata ;
    skos:altLabel "Claim_Source_Section" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Source_Section",
  "description": "The article section from which the quote was taken.",
  "example": "\\"Results\\"",
  "allowed_values": [
    "Abstract",
    "Conclusion",
    "Discussion",
    "Figures",
    "Introduction",
    "Methods",
    "References",
    "Results",
    "Tables",
    "Title"
  ],
  "normalization": "Give the section of the article the quote was taken from. Use one of the allowed values."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimSourceSection" .

cdbo:hasClaimStatement a owl:AnnotationProperty ;
    rdfs:label "Claim Statement" ;
    obo:IAO_0000112 "Young children with ASD have increased gray matter volumes in the left fusiform gyrus compared with TD children." ;
    dcterms:bibliographicCitation "Groth P, Gibson A, Velterop J. The anatomy of a nanopublication. Information Services and Use 2010;30:51-56. doi:10.3233/ISU-2010-0613",
        "Kuhn T, Barbano PE, Nagy ML, Krauthammer M. Broadening the scope of nanopublications. In: The Semantic Web: Semantics and Big Data (ESWC 2013). Lecture Notes in Computer Science 7882:487-501. doi:10.1007/978-3-642-38288-8_33" ;
    dcterms:description "One atomic claim written as a single self-contained sentence: one finding about one condition, one region, one measure and one direction, against one comparator. A sentence that reports several regions yields several claims." ;
    rdfs:comment "The statement follows the AIDA criteria (atomic, independent, declarative, absolute) and is the assertion of a nanopublication."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasClaimStatementMetadata ;
    skos:altLabel "Claim_Statement" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Statement",
  "description": "One atomic claim written as a single self-contained sentence: one finding about one condition, one region, one measure and one direction, against one comparator. A sentence that reports several regions yields several claims.",
  "example": "\\"Young children with ASD have increased gray matter volumes in the left fusiform gyrus compared with TD children.\\"",
  "normalization": "Write each claim as an AIDA sentence (Kuhn et al. 2013). Atomic: one finding about one condition, one region, one measure and one direction, against one comparator; if a sentence reports several regions, measures, directions or population subgroups (for example age groups or sexes), write one claim for each. Independent: the sentence must be understandable without the article, so name the group, the comparator and any age group stated in the article, and never use 'we', 'this effect', 'the former' or a reference to a table or figure. Declarative: a complete sentence that could be true or false. Absolute: state the finding itself in the present tense, without hedges such as 'probably' or 'suggests' and without phrases about how it was found, such as 'the analysis showed that'. Do not include p-values or other statistics in the sentence."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimStatement" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasClaimSurvivedCorrection a owl:AnnotationProperty ;
    rdfs:label "Claim Survived Correction" ;
    obo:IAO_0000112 "Yes" ;
    dcterms:description "Whether the finding remained significant after multiple-comparison correction." ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:yesNoType ;
    rdfs:subPropertyOf cdbo:hasClaimContextMetadata ;
    skos:altLabel "Claim_Survived_Correction" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Survived_Correction",
  "description": "Whether the finding remained significant after multiple-comparison correction.",
  "example": "\\"Yes\\"",
  "allowed_values": [
    "Yes",
    "No",
    "Not Specified"
  ],
  "normalization": "Write Yes only if the article states that the finding remained significant after multiple-comparison correction. Write No if the article reports it as significant only without correction or as not surviving. Otherwise write 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimSurvivedCorrection" ;
    cdbo:hasTypicalArticleSection "Results",
        "Tables" .

cdbo:hasClaimVariableType a owl:AnnotationProperty ;
    rdfs:label "Claim Variable Type" ;
    obo:IAO_0000112 "Diagnosis" ;
    dcterms:bibliographicCitation "Morgan RL, Whaley P, Thayer KA, Schünemann HJ. Identifying the PECO: A framework for formulating good questions to explore the association of environmental and other exposures with health outcomes. Environment International 2018;121(Pt 1):1027-1031. doi:10.1016/j.envint.2018.07.015",
        "Richardson WS, Wilson MC, Nishikawa J, Hayward RS. The well-built clinical question: a key to evidence-based decisions. ACP Journal Club 1995;123(3):A12-3." ;
    dcterms:description "The kind of variable the condition slot holds: a diagnosis, a trait or phenotype, an exposure, a demographic variable or something else." ;
    rdfs:comment "Population (PICO) or exposure group (PECO): the target group of the claim."@en ;
    rdfs:domain CDBO:0000003 ;
    rdfs:range cdbo:variableType ;
    rdfs:subPropertyOf cdbo:hasClaimSlotMetadata ;
    skos:altLabel "Claim_Variable_Type" ;
    cdbo:hasClaimExtractionPrompt """{
  "field": "Claim_Variable_Type",
  "description": "The kind of variable the condition slot holds: a diagnosis, a trait or phenotype, an exposure, a demographic variable or something else.",
  "example": "\\"Diagnosis\\"",
  "allowed_values": [
    "Diagnosis",
    "Trait or Phenotype",
    "Exposure",
    "Demographic",
    "Other"
  ],
  "normalization": "Classify the condition or variable of interest: Diagnosis for a clinical diagnosis group, Trait or Phenotype for a behavioral, cognitive or physical trait, Exposure for an environmental or lifestyle exposure, Demographic for age, sex or similar, Other otherwise."
}"""^^rdf:JSON ;
    cdbo:hasCompactURI "cdbo:hasClaimVariableType" ;
    cdbo:hasTypicalArticleSection "Abstract",
        "Results" .

cdbo:hasCompactURI a owl:AnnotationProperty ;
    rdfs:label "has compact URI"@en ;
    dcterms:description "The CURIE form of the property IRI."@en ;
    rdfs:subPropertyOf dcterms:identifier .

cdbo:hasContentHash a owl:AnnotationProperty ;
    rdfs:label "Content Hash" ;
    dcterms:description "A hash of the source file, used to detect byte-identical duplicates." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasRegistryMetadata ;
    skos:altLabel "Content_Hash" ;
    cdbo:hasCompactURI "cdbo:hasContentHash" .

cdbo:hasCovariates a owl:AnnotationProperty ;
    rdfs:label "Covariates" ;
    obo:IAO_0000112 "Age, sex, site and total intracranial volume" ;
    dcterms:description "The covariates included in the statistical model." ;
    rdfs:domain CDBO:0000002 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasStatisticalMethodsMetadata ;
    skos:altLabel "Covariates" ;
    cdbo:hasCompactURI "cdbo:hasCovariates" ;
    cdbo:hasStudyMetadataExtractionPrompt """{
  "field": "Covariates",
  "description": "The covariates included in the statistical model.",
  "example": "\\"Age, sex, site and total intracranial volume\\"",
  "normalization": "List the covariates entered into the statistical model, separated by commas. If the article states that no covariates were used, write 'None'. If the article does not report the value, write the literal string 'Not Specified'."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasDOILink a owl:AnnotationProperty ;
    rdfs:label "DOI Link" ;
    dcterms:description "The DOI link of the article." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:anyURI ;
    rdfs:subPropertyOf cdbo:hasPublicationLink ;
    skos:altLabel "DOI_Link" ;
    cdbo:hasCompactURI "cdbo:hasDOILink" .

cdbo:hasDocumentType a owl:AnnotationProperty ;
    rdfs:label "Document Type" ;
    dcterms:description "Whether the source file is a native PDF with a text layer or a scanned PDF that requires OCR." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range cdbo:documentType ;
    rdfs:subPropertyOf cdbo:hasRegistryMetadata ;
    skos:altLabel "Document_Type" ;
    cdbo:hasCompactURI "cdbo:hasDocumentType" .

cdbo:hasDuplicateOfID a owl:AnnotationProperty ;
    rdfs:label "Duplicate Of ID" ;
    dcterms:description "Links a Publication to the Publication it duplicates, for example a preprint and its published version, so that both are not counted as independent confirmations." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range CDBO:0000001 ;
    rdfs:subPropertyOf cdbo:hasRegistryMetadata ;
    skos:altLabel "Duplicate_Of_ID" ;
    cdbo:hasCompactURI "cdbo:hasDuplicateOfID" .

cdbo:hasExtractionDate a owl:AnnotationProperty ;
    rdfs:label "Extraction Date" ;
    dcterms:description "The date and time of the extraction run." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:dateTime ;
    rdfs:subPropertyOf cdbo:hasExtractionProvenanceMetadata ;
    skos:altLabel "Extraction_Date" ;
    cdbo:hasCompactURI "cdbo:hasExtractionDate" .

cdbo:hasExtractionModelID a owl:AnnotationProperty ;
    rdfs:label "Extraction Model ID" ;
    dcterms:description "The identifier of the language model that performed the extraction." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasExtractionProvenanceMetadata ;
    skos:altLabel "Extraction_Model_ID" ;
    cdbo:hasCompactURI "cdbo:hasExtractionModelID" .

cdbo:hasExtractionPromptVersion a owl:AnnotationProperty ;
    rdfs:label "Extraction Prompt Version" ;
    dcterms:description "The version of the prompts, assembled from the ontology, used for the extraction." ;
    dcterms:type cdbo:lookupOnly ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf cdbo:hasExtractionProvenanceMetadata ;
    skos:altLabel "Extraction_Prompt_Version" ;
    cdbo:hasCompactURI "cdbo:hasExtractionPromptVersion" .

cdbo:hasFullTextAvailable a owl:AnnotationProperty ;
    rdfs:label "Full Text Available" ;
    dcterms:description "Whether the full text of the article is available. Abstract-only records are processed with evidence level Abstract Only and are not sent to SciScore." ;
    dcterms:type cdbo:preprocessing ;
    rdfs:domain CDBO:0000001 ;
    rdfs:range cdbo:yesNoType ;
    rdfs:subPropertyOf cdbo:hasRegistryMetadata ;
    skos:altLabel "Full_Text_Available" ;
    cdbo:hasCompactURI "cdbo:hasFullTextAvailable" .

cdbo:hasGeneralClaimExtractionPrompt a owl:AnnotationProperty ;
    rdfs:label "General Claim Extraction Prompt"@en ;
    rdfs:range rdf:JSON ;
    rdfs:subPropertyOf cdbo:hasLLMExtractionPrompt ;
    skos:altLabel "General_Claim_Extraction_Prompt" .

cdbo:hasGeneralClaimsDBExtractionPrompt a owl:AnnotationProperty ;
