  "field": "Pulse_Sequence",
  "description": "The pulse sequence and its main acquisition parameters.",
  "example": "\\"MPRAGE, TR 2300 ms, TE 2.98 ms, flip angle 9 degrees\\"",
  "normalization": "Report the value as written in the article. If several values apply (for example several scanners or sites), list them separated by semicolons. If the article does not report the value, write the literal string 'Not Specified'. Include the main acquisition parameters the article reports (for example TR, TE, flip angle)."
}"""^^rdf:JSON ;
    cdbo:hasTypicalArticleSection "Methods" .

cdbo:hasReportedStudyID a owl:AnnotationProperty ;
