    rdfs:domain CDBO:0000001 ;
    rdfs:range xsd:decimal ;
    rdfs:subPropertyOf cdbo:hasSciScoreMetadata ;
    skos:altLabel "SciScore_Total" ;
    cdbo:hasCompactURI "cdbo:hasSciScoreTotal" .

cdbo:hasSciScoreVersion a owl:AnnotationProperty ;
