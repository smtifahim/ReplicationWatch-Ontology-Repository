@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

obo:BSPO_0000000 a owl:Class ;
    rdfs:label "left side"@en ;
    iao:0000115 "The side of an organism that is left of the sagittal plane."@en ;
    rdfs:subClassOf obo:BSPO_0000054 .

obo:BSPO_0000007 a owl:Class ;
    rdfs:label "right side"@en ;
    iao:0000115 "The side of an organism that is right of the sagittal plane."@en ;
    rdfs:subClassOf obo:BSPO_0000054 .

<https://w3id.org/replicationwatch/cdbo/imports/bspo-laterality-slice> a owl:Ontology ;
    rdfs:label "BSPO side terms for laterality (slice)" ;
    dcterms:created "2026-11-05" ;
    dcterms:license <https://creativecommons.org/licenses/by/3.0/> ;
    dcterms:source <https://github.com/obophenotype/biological-spatial-ontology/tree/21f4b75> .

obo:BSPO_0000054 a owl:Class ;
    rdfs:label "anatomical side"@en ;
    iao:0000115 "An anatomical region bounded by a plane perpendicular to an axis through the middle."@en .

