@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix nidm: <http://purl.org/nidash/nidm#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

nidm:Amperometry a owl:Class ;
    rdfs:label "Amperometry" ;
    iao:0000115 "Amperometry is an extracellular acquisition method in electrophysiology in which an electrode is brought near a cell to detect the release of ions by vesicles."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Anatomical a owl:Class ;
    rdfs:label "Anatomical" ;
    iao:0000115 "Anatomical is a description of the usage of a given acquisition object, indicating that the purpose of the object is to provide information on the anatomy of the object on which the acquisition was performed."^^xsd:string ;
    rdfs:subClassOf nidm:ImageUsageType .

nidm:Angiography a owl:Class ;
    rdfs:label "Angiography"^^xsd:string ;
    iao:0000115 "Angiography is an acquisition method that visualizes the venus and arterial systems of the body."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:ArterialSpinLabeling a owl:Class ;
    rdfs:label "Arterial Spin Labeling"^^xsd:string ;
    iao:0000115 "Arterial spin labeling is a magnetic resonance imaging acquisition method that measures perfusion using the flow of saturated blood into a predefined area by comparing the image intensity obtained in the slice with and without the saturation pulse."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:BloodOxygenLevelDependentWeighted a owl:Class ;
    rdfs:label "Blood Oxygen Level Dependent Weighted"^^xsd:string ;
    iao:0000115 "Blood Oxygen Level Dependent Weighted is an image contrast type in which differences in voxel intensity are based on magnetic susceptibility differences between oxygenated and de-oxygenated blood."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:CurrentClamp a owl:Class ;
    rdfs:label "Current Clamp" ;
    iao:0000115 "A current clamp is an intracellular electrophysiology acquisition method in which current is injected into a cell and the voltage generated by the cell is recorded." ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:DiffusionTensor a owl:Class ;
    rdfs:label "Diffusion Tensor"^^xsd:string ;
    iao:0000115 "Diffusion tensor is an image usage type that denotes that the acquisition object collected can be used to construct the diffusion tensor of the imaged tissue."^^xsd:string ;
    rdfs:subClassOf nidm:ImageUsageType .

nidm:DiffusionWeighted a owl:Class ;
    rdfs:label "Diffusion Weighted"^^xsd:string ;
    iao:0000115 "Diffusion weighted is an image contrast type in which differences in voxel intensity are based on the brownian-motion behavior of the species that generates the detected signal from that voxel."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:DistortionCorrection a owl:Class ;
    rdfs:label "DistortionCorrection" ;
    iao:0000115 "Distortion correction is a description of the usage of a given acquisition object, indicating that the purpose of the object is to provide information used to correct distortions in a set of images."^^xsd:string ;
    rdfs:subClassOf nidm:ImageUsageType .

nidm:DynamicContrastEnhanced a owl:Class ;
    rdfs:label "Dynamic Contrast Enhanced"^^xsd:string ;
    iao:0000115 "Dynamic contrast enhanced is a magnetic resonance imaging acquisition method in which T1-weighted images are acquired both before and then sequentially after a contrast agent has been injected in order to quantify metrics related to the permeability of the blood-brain barrier."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:DynamicSusceptibilityContrast a owl:Class ;
    rdfs:label "Dynamic Susceptibility Contrast"^^xsd:string ;
    iao:0000115 "Dynamic sysceptibility contrast is a magnetic resonance imaging acquisition method in which T2*-weighted images are acquired sequentially after a contrast agent has been injected in order to quantify metrics related to blood volume and flow."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Electrocardiography a owl:Class ;
    rdfs:label "Electrocardiography"^^xsd:string ;
    iao:0000115 "Electrocardiography (ECG) is an electrophysiological acquisition method in which electrodes placed on the skin measure the electrical activity of the heart."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Electrocorticography a owl:Class ;
    rdfs:label "Electrocorticography"^^xsd:string ;
    iao:0000115 "Electrocorticography (ECoG) is an electrophysiological acquisition method in which the electrical activity of the brain is measured using electrodes that are placed directly on the cortical surface of the brain."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Electrode a owl:Class ;
    rdfs:label "Electrode"^^xsd:string ;
    iao:0000115 "An electrode is a data acquisition device that consists of a conductor that is used to record an electrical signal from a study participant."^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:Electroencephalography a owl:Class ;
    rdfs:label "Electroencephalography"^^xsd:string ;
    iao:0000115 "Electroencephalography (EEG) is an electrophysiological acquisition method in which the electrical activity of the brain is measured using electrodes that are placed on the surface of the head."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:ElectroencephalographyAcquisitionDevice a owl:Class ;
    rdfs:label "Electroencephalography Acquisition Device"^^xsd:string ;
    iao:0000115 "An electroencephalography (EEG) acquisition device is a device that measures the electrical activity of the brain and consists of a set of electrodes placed on the surface of the head and a recording device that collects the signal from each electrode."^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:Electromyography a owl:Class ;
    rdfs:label "Electromyography"^^xsd:string ;
    iao:0000115 "Electromyography (EMG) is an electrophysiological acquisition method in which the electrical activity of the muscles is measured using either surface or inserted electrodes."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Electrooculography a owl:Class ;
    rdfs:label "Electrooculography"^^xsd:string ;
    iao:0000115 "Electrooculography (EOG) is an electrophysiological acquisition method in which the resting potential between the cornea of the eye and Bruch's membrance is measured."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:ElectrophysiologyRecording a owl:Class ;
    rdfs:label "Electrophysiology Recording"^^xsd:string ;
    iao:0000115 "Electrophysiology Recording is an acquisition modality in which electrical signals are recorded from one or more electrodes inserted into living tissue."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionModality .

nidm:Encephalography a owl:Class ;
    rdfs:label "Electroencephalography"^^xsd:string ;
    iao:0000115 "Encephalography is an acquisition modality in which the electrical activity or structure of the brain is measured using a variety of techniques."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionModality .

nidm:EyeTrackingDevice a owl:Class ;
    rdfs:label "Eye Tracking Device" ;
    iao:0000115 "An eye tracking device is a device that consists of hardware that follows the motion of one or both eyes of the study participant, which allows the determination of either the gaze location or of relative eye motion."^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:FastFieldEcho a owl:Class ;
    rdfs:label "Fast Field Echo"^^xsd:string ;
    iao:0000115 "Fast Field Echo is a magnetic resonance imaging acquisition method that employs a gradient to dephase and rephase the signal to create an echo, a gradient-recalled echo, which is then measured."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:FieldPotential a owl:Class ;
    rdfs:label "Field Potential" ;
    iao:0000115 "The field potential is an extracellular electrophysiology acquisition method in which an electrode is used to measure the voltage that is generated by synaptic activity (in neural tissue)."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:FlowWeighted a owl:Class ;
    rdfs:label "Flow Weighted"^^xsd:string ;
    iao:0000115 "Flow weighted is an image contrast type in which differences in voxel intensity are based on the bulk motion behavior of the species that generates the detected signal from that voxel."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:FluidAttenuatedInversionRecovery a owl:Class ;
    rdfs:label "Fluid Attenuated Inversion Recovery"^^xsd:string ;
    iao:0000115 "Fluid Attenuated Inversion Recovery, which is often known by its acronym, FLAIR, is a magnetic resonance imaging acquisition method in which images are acquired after an initial magnetization inversion pulse is applied and a delay duration that is selected such that the signal from bulk fluid such as cerebral spinal fluid or fluid in lesions is nulled."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Functional a owl:Class ;
    rdfs:label "Functional"^^xsd:string ;
    iao:0000115 "Functional is a description of the usage of a given acquisition object, indicating that the purpose of the object is to provide information on the biological function of some aspect of the object on which the acquisition was performed."^^xsd:string ;
    rdfs:subClassOf nidm:ImageUsageType .

nidm:GradientRecalledEcho a owl:Class ;
    rdfs:label "Gradient Recalled Echo"^^xsd:string ;
    iao:0000115 "Gradient recalled echo is a magnetic resonance imaging acquisition method in which the echo used in the measurement is generated by application and subsequent reversal of the frequency-encoding gradient and is characterized by flip angles of less than 90 degrees and the evolution being governed by T2star decay."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:HeartRateMonitor a owl:Class ;
    rdfs:label "Heart Rate Monitor"^^xsd:string ;
    iao:0000115 "A heart rate monitor is a data acquisition device that records the number of heart beats in a given period of time of a subject."^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:ImageAcquisitionDevice a owl:Class ;
    rdfs:label "Image Acquisition Device"^^xsd:string ;
    iao:0000115 "An image acquisition device is a data acquisition device that has an image as its primary output."^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:IntracranialElectroencephalography a owl:Class ;
    rdfs:label "Intracranial Electroencephalography"^^xsd:string ;
    iao:0000115 "Intracranial Electroencephalography (iEEG) is an electrophysiological acquisition method in which the electrical activity of the brain is measured using electrodes that are placed directly on the surface of the brain."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:LinearAttenuationCoefficient a owl:Class ;
    rdfs:label "Linear Attenuation Coefficient"^^xsd:string ;
    iao:0000115 "Linear attenuation coefficient is an image contrast type in which differences in voxel intensity reflect differences in the density and atomic number of the sample."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:Localization a owl:Class ;
    rdfs:label "Localization" ;
    iao:0000115 "Localization is a description of the usage of a given acquisition object, indicating that the purpose of the object is to provide information on the placement and orientation of the imaged object in space."^^xsd:string ;
    rdfs:subClassOf nidm:ImageUsageType .

nidm:MagneticResonanceImaging a owl:Class ;
    rdfs:label "Magnetic Resonance Imaging" ;
    iao:0000115 "Magnetic Resonance Imaging is an acquisition modality in which radiofrequency electromagnetic radiation is used to excite nuclei of the study participant and the characteristics of the detected signal are used to generate intensity contrast between different tissue types or structures."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionModality .

nidm:MagnetizationTransfer a owl:Class ;
    rdfs:label "Magnetization Transfer"^^xsd:string ;
    iao:0000115 "Magnetization transfer is a magnetic resonance imaging acquisition method in which a radiofrequency pulse is applied off resonance (with respect to free protons)and the saturation transfer between protons bound to macromolecules and free protons is measured."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Magnetoencephalography a owl:Class ;
    rdfs:label "Magnetoencephalography" ;
    iao:0000115 "Magnetoencephalography (MEG) is an acquisition modality in which the magnetic fields, resulting from electrical activity in the brain, are detected and used to elucidate the time course of brain electrical activity."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionModality .

nidm:MagnetoencephalographyAcquisitionDevice a owl:Class ;
    rdfs:label "Magnetoencephalography Acquisition Device"^^xsd:string ;
    iao:0000115 "An magnetoencephalography (MEG) acquisition device is a device that measures magnetic signals generated by the electrical activity of the brain and consists of a set of magnetometers placed near the surface of the head and a recording device that collects the signal from each electrode."^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:MaximumIntensityProjection a owl:Class ;
    rdfs:label "Maximum Intensity Projection"^^xsd:string ;
    iao:0000115 "Maximum intensity projection is an image contrast type in which differences in voxel intensity reflect differences in the maximum value of the collection of that voxel and its surrounding neighbors."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:MultiUnitRecording a owl:Class ;
    rdfs:label "Multi-unit Recording" ;
    iao:0000115 "Multi-unit recording is an extracellular electrophysiological acquisition method in which an acquisition object is gathered using multiple recording devices." ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:MultielectrodeArray a owl:Class ;
    rdfs:label "Multi-electrode Array"^^xsd:string ;
    iao:0000115 "A multi-electrode array is a data acquisition device that records more than one concurrent electrical signal from study participant or sample."^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:NuclearMagneticResonanceDevice a owl:Class ;
    rdfs:label "Nuclear Magnetic Resonance Device" ;
    iao:0000115 "A Nuclear magnetic resonance device is an data acquisition device in which radiofrequency electromagnetic radiation is used to excite nuclei of the study participant, the characteristics of the detected signal are used to infer information regarding the chemical or physical environment of the sample."^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:NuclearMagneticResonanceSpectroscopicImaging a owl:Class ;
    rdfs:label "Nuclear Magnetic Resonance Spectroscopic Imaging" ;
    iao:0000115 "Nuclear magnetic resonance spectroscopic imaging is an acquisition modality in which radiofrequency electromagnetic radiation is used to excite nuclei of the study participant, the characteristics of the detected signal are used to generate intensity contrast over a restricted (usually grid-like) area, and the resulting signal is displayed as a spectrum for each one of the spatially-resolved areas."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionModality .

nidm:NuclearMagneticResonanceSpectroscopy a owl:Class ;
    rdfs:label "Nuclear Magnetic Resonance Spectroscopy" ;
    iao:0000115 "Nuclear magnetic resonance spectroscopy is an acquisition modality in which radiofrequency electromagnetic radiation is used to excite nuclei of the study participant, the characteristics of the detected signal are used to generate signal intensity contrast over an entire selected volume, and the resulting signal is displayed as a signal spectrum rather than as matrix meant to be a representation of the underlying object."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionModality .

nidm:ParallelImaging a owl:Class ;
    rdfs:label "Parallel Imaging"^^xsd:string ;
    iao:0000115 "Parallel imaging is an acquisition method used in magnetic resonance imaging to acquire the k-space data in which multiple coils are employed and the signals from each coil are disambiguated using the coil sensitivity profile."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:PatchClamp a owl:Class ;
    rdfs:label "Patch Clamp" ;
    iao:0000115 "Patch clamp is an intracellular electrophysiological acquisiiton method in which a micropipette tip is brought near a cell and scution applied drawing a section of cell membrane into the tip in order that ion movement or the intracellular environment can be studied."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Perfusion a owl:Class ;
    rdfs:label "Perfusion" ;
    iao:0000115 "Perfusion is a description of the usage of a given acquisition object, indicating that the purpose of the object is to provide information on the blood flow of the object on which the acquisition was performed."^^xsd:string ;
    rdfs:subClassOf nidm:ImageUsageType .

nidm:PositronEmissionTomography a owl:Class ;
    rdfs:label "Positron Emission Tomography" ;
    iao:0000115 "Positron emission tomography is an acquisition modality in which a positron-emitting radioactive tracer is introduced into the study participant and the gamma rays emitted after a positron-electron collision are detected and their originating position calculated."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionModality .

nidm:ProtonDensityWeighted a owl:Class ;
    rdfs:label "Proton Density Weighted" ;
    iao:0000115 "Proton density weighted is a image contrast type in magnetic resonance imaging in which differences in voxel intensity reflect underlying differences in the number of protons in those voxels."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:QuantitativeSusceptibilityMapping a owl:Class ;
    rdfs:label "Quantitative Susceptibility Mapping"^^xsd:string ;
    iao:0000115 "Quantitative susceptibility mapping is a magentic resonance imaging image-usage type in which differences in voxel intensity reflect quantitative differences magnetic susceptibilty of the underlying sample."^^xsd:string ;
    rdfs:subClassOf nidm:ImageUsageType .

nidm:ReceiveCoil a owl:Class ;
    rdfs:label "Receive Coil" ;
    iao:0000115 "A receive coil is a data acquisition device used in nuclear magnetic resonance and magnetic resonance imaging to receive the signal from the sample. "^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:RespirationRateMonitor a owl:Class ;
    rdfs:label "Respiration Rate Monitor"^^xsd:string ;
    iao:0000115 "A respiration rate monitor is a data acquisition device that records the number of breaths taken by a study participant in a given period of time."^^xsd:string ;
    rdfs:subClassOf nidm:DataAcquisitionDevice .

nidm:SharpElectrode a owl:Class ;
    rdfs:label "Sharp Electrode" ;
    iao:0000115 "Sharp electrode is intracellular electrophysiological acquisition method used for measuring the potential of the intracellular environment with minimal disturbance of that environment, in which a pipette, filled with electrolyte and with a very small opening, is inserted into the cell and the potential measured."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:SimultaneousMultislice a owl:Class ;
    rdfs:label "Simultaneous Multislice"^^xsd:string ;
    iao:0000115 "Simultaneous multislice is an acquisition method in magnetic resonance imaging used to acquire the k-space in which data from multiple slices are acquired at the same time and the coil sensitivity profiles are used to separate the data from each slice."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:SinglePhotonEmissionComputedTomography a owl:Class ;
    rdfs:label "Single Photon Emission Computed Tomography" ;
    iao:0000115 "Single-photon emission computed tomography (SPECT)is an acquisition modality in which a gamma-ray-emitting radioisotope is introduced into the study participant and the emitted gamma rays are detected in a series of cross-sectional views, acquired in detectors encircling the study participant, enabling a three-dimensional volume to be reconstructed using a tomographic reconstruction method."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionModality .

nidm:SingleUnitReccording a owl:Class ;
    rdfs:label "Single-unit Recording" ;
    iao:0000115 "Single-unit recording is an extracellular electrophysiological acquisition method, in which a thin electrode is introduced into the extracellular space of the study participant and the action potential from a single neuron is recorded."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:SpinEcho a owl:Class ;
    rdfs:label "Spin Echo"^^xsd:string ;
    iao:0000115 "Spin echo is a magnetic resonance imaging acquisition method in which the echo used in the measurement is generated by application of an initial radiofrequency pulse and a subsequent pulse, generally, though not necessarily, with flip angles of 90 and 180 degrees respectively."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:SteadyStateFreePrecession a owl:Class ;
    rdfs:label "Steady State Free Precession"^^xsd:string ;
    iao:0000115 "Steady State Free Precession is a magnetic resonance imaging acquisition method that uses the steady state magnetization, formed by a series of phase-alternated radiofrequency pulses, spoiler gradients in the slice-selection direction, rewinder gradients in the phase-encoding direction to form images."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Stereoelectroencephalography a owl:Class ;
    rdfs:label "Stereoelectroencephalography"^^xsd:string ;
    iao:0000115 "Stereoelectroencephalography (SEEG) is an electrophysiological acquisition method in which the electrical activity of the brain is measured with stereotactically-implanted electrodes, usually to localize an epileptogenic zone."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:Structural a owl:Class ;
    rdfs:label "Structural"^^xsd:string ;
    iao:0000115 "A stimulus response file is an auxiliary file that contains the recorded response of the study participant to an experimental stimulus the course of a task-based assessment activity."^^xsd:string ;
    rdfs:subClassOf nidm:ImageUsageType .

nidm:SusceptibilityWeighted a owl:Class ;
    rdfs:label "Susceptibility Weighted"^^xsd:string ;
    iao:0000115 "Susceptibility weighted is a magentic resonance imaging image-contrast type in which differences in voxel intensity reflect differences in magnetic susceptibilty of the underlying sample."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:SusceptibilityWeightedImaging a owl:Class ;
    rdfs:label "Susceptibility Weighted Imaging"^^xsd:string ;
    iao:0000115 "Susceptibility weighted imaging is a magentic resonance imaging image-usage type in which differences in voxel intensity reflect differences in magnetic susceptibilty of the underlying sample, but are not caculated values."^^xsd:string ;
    rdfs:subClassOf nidm:ImageUsageType .

nidm:T1RhoWeighted a owl:Class ;
    rdfs:label "T1 Rho Weighted"^^xsd:string ;
    iao:0000115 "T1 Rho weighted is an image contrast type in which the transvers magnetization is locked into the transverse plane and therefore differences in voxel intensity reflect differences in interactions of the transverse magnetization of the probe molecule with the lattice (rather than the spin-lattice relaxation time) in the underlying sample."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:T1Weighted a owl:Class ;
    rdfs:label "T1 Weighted"^^xsd:string ;
    iao:0000115 "T1 weighted is an image contrast type in which differences in voxel intensity reflect differences in the spin-lattice relaxation time of the probe in the underlying sample."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:T2StarWeighted a owl:Class ;
    rdfs:label "T2 Star Weighted"^^xsd:string ;
    iao:0000115 "T2 star weighted is an image contrast type in which differences in voxel intensity reflect differences in the spin-spin relaxation time  of the probe as well as the field inhomogeneities in the underlying sample."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:T2Weighted a owl:Class ;
    rdfs:label "T2 Weighted"^^xsd:string ;
    iao:0000115 "T2 weighted is an image contrast type in which differences in voxel intensity reflect differences in the spin-spin relaxation time  of the probe in the underlying sample."^^xsd:string ;
    rdfs:subClassOf nidm:ImageContrastType .

nidm:VoltageClamp a owl:Class ;
    rdfs:label "Voltage Clamp" ;
    iao:0000115 "Voltage clamp is an intracellular electrophysiological acquisition method in in which the cell membrane potential is fixed to a set value and the ionic current that crosses the cell membrane at that potential is measured."^^xsd:string ;
    rdfs:subClassOf nidm:AcquisitionMethod .

nidm:X-ray a owl:Class ;
    rdfs:label "X-ray" ;
    iao:0000115 "X-ray is an acquisition modality in which an x-ray beam is directed across a body part or sample of interest with film placed on the opposite side resulting in an image in which the contrast is generated by the differential absorption of x-rays." ;
    rdfs:subClassOf nidm:AcquisitionModality .

nidm:X-rayComputedTomography a owl:Class ;
    rdfs:label "X-ray Computed Tomography" ;
    iao:0000115 "X-ray Computed tomography is an acquisition modality in which an x-ray beam is scanned across a study participant and the resulting data is reconstructed into two-dimensional slices or a three-dimensional volume in which the contrast is generated by the differential absorption of x-rays." ;
    rdfs:subClassOf nidm:AcquisitionMethod .

<https://w3id.org/replicationwatch/cdbo/imports/nidm-imaging-slice> a owl:Ontology ;
    rdfs:label "NIDM-Experiment imaging terms (slice)" ;
    dcterms:created "2026-11-05" ;
    dcterms:description "Vendored slice of the NIDM-Experiment ontology: the subclasses of acquisition modality, image contrast type, acquisition method, image usage type and data acquisition device. Used to normalize Imaging_Modality, Pulse_Sequence and related study fields. Terms keep their original NIDM IRIs." ;
    dcterms:license <http://www.apache.org/licenses/LICENSE-2.0> ;
    dcterms:source <https://github.com/incf-nidash/nidm-specs/blob/b568043b81e75110d63b994c00aa17275a5f4614/nidm/nidm-experiment/terms/nidm-experiment.owl> .

nidm:AcquisitionModality a owl:Class ;
    rdfs:label "Acquisition Modality" ;
    iao:0000115 "An acquisition modality is a description of the general type of experiment that was used to gather data from a study participant."^^xsd:string .

nidm:ImageUsageType a owl:Class ;
    rdfs:label "Image Usage Type"^^xsd:string ;
    iao:0000115 "Image Usage Type is an acquisition object quality that denotes to what purpose the acquired object will be employed."^^xsd:string .

nidm:DataAcquisitionDevice a owl:Class ;
    rdfs:label "Data Acquisition Device" ;
    iao:0000115 "A data acquisition device is a device that collects a packet or stream of analog or digital information from an entity." .

nidm:ImageContrastType a owl:Class ;
    rdfs:label "Image Contrast Type"^^xsd:string ;
    iao:0000115 "Image Contrast Type is an acquisition object quality that denotes the physical properties on which differences in image intensity, in an image, are based."^^xsd:string .

nidm:AcquisitionMethod a owl:Class ;
    rdfs:label "Acquisition Method" ;
    iao:0000115 "An acquisition method is a specific form of a procedure that was used to gather data from a study participant."^^xsd:string .

