# ===== Study =====

study:SE-S1
    rdf:type cdbo:CDBO_0000002 ;
    cdbo:hasAnalysisSettings "GMV: SPM12 VBM, images co-registered to the white matter tissue probability map, segmented, study-specific template spatially normalized to MNI space with DARTEL, 8 mm FWHM Gaussian smoothing, intensity threshold 0.2. CT: custom tissue probability map from Template-O-Matic (TOM8), segmentation in CAT12, 10 mm smoothing. Both: 2 x 2 full factorial model, voxel-wise height threshold p < 0.005 uncorrected, cluster-level extent threshold p < 0.05 FDR corrected." ;
    cdbo:hasAnalysisSoftware "SPM12; CAT12; Template-O-Matic (TOM8) toolbox; label4MRI" ;
    cdbo:hasAnalysisSoftwareVersion "Not Specified" ;
    cdbo:hasAtlasParcellation "Brodmann areas and anatomical labels assigned with the label4MRI package" ;
    cdbo:hasMorphometryMethod "Voxel-Based Morphometry" ;
    cdbo:hasOperatingSystem "Not Specified" ;
    cdbo:hasStudyDataset "ABCD Study, Annual Release 3.0, baseline time point (NDA DOI 10.15154/gx74-8w05)" ;
    cdbo:hasImageResolution "1 x 1 x 1 mm3 voxel resolution" ;
    cdbo:hasImagingModality "Structural MRI (whole-brain T1-weighted)" ;
    cdbo:hasImagingModalityMappedCurie "[\"nidm:MagneticResonanceImaging\", \"nidm:Structural\", \"nidm:T1Weighted\"]"^^rdf:JSON ;
    cdbo:hasMagneticFieldStrength "3T" ;
    cdbo:hasPulseSequence "T1-weighted; acquisition parameters are not given in the article (referred to the ABCD imaging protocol document)" ;
    cdbo:hasScannerManufacturerModel "Not Specified" ;
    cdbo:hasCovariates "GMV: total GMV, study site, scanner type, ADHD scores. CT: study site, scanner type, ADHD scores. Age and sex were not included." ;
    cdbo:hasMultipleComparisonCorrection "Cluster-level FDR correction at p < 0.05 (voxel-wise height threshold p < 0.005, uncorrected)" ;
    cdbo:hasStatisticalTest "2 x 2 full factorial analysis (ANOVA): main effect of Reading Ability, main effect of Language Background, and their interaction" ;
    cdbo:hasStudyDesignType "2 x 2 factorial group comparison (Reading Ability by Language Background) on ABCD baseline data" ;
    cdbo:hasPublicationID "SE-P1" ;
    cdbo:hasStudyID "SE-S1" .

