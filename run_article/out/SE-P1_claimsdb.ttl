    cdbo:hasClaimSourceReference "Table S3" ;
    cdbo:hasClaimSourceSection "Results" ;
    cdbo:hasClaimStatement "Children aged 9 to 10 years with reading disability have less cortical thickness in the left calcarine fissure than control children." ;
    cdbo:hasReportingPublicationID "SE-P1" ;
    cdbo:hasSourceStudyID "SE-S1" ;
    csdo:inClaimGroup grp:bc8588a0edb6e864e088a02b0c2c917a2096ff77 .

